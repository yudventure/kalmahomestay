# Salin menjadi .env lalu isi dengan data asli Kalma
PORT=3000
SITE_URL=https://kalma-rajaampat.com

# Nomor WhatsApp tujuan pemesanan, format internasional tanpa + (contoh: 6281234567890)
WHATSAPP_NUMBER=6281234567890
# Tampilan nomor di website (opsional)
WHATSAPP_DISPLAY=+62 812-3456-7890
CONTACT_EMAIL=hello@kalma-rajaampat.com
INSTAGRAM_HANDLE=kalma.rajaampat

# Password halaman /admin (user: admin). Kosongkan untuk menonaktifkan admin.
ADMIN_PASSWORD=

# Folder penyimpanan pertanyaan pemesanan (default: ./data)
# DATA_DIR=./data
