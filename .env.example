# Salin menjadi .env lalu isi dengan data asli Kalma
PORT=3000
SITE_URL=https://kalma-rajaampat.com

# Nomor WhatsApp tujuan pemesanan, format internasional tanpa + (contoh: 6281234567890)
WHATSAPP_NUMBER=6281234567890
# Tampilan nomor di website (opsional)
WHATSAPP_DISPLAY=+62 812-3456-7890
CONTACT_EMAIL=hello@kalma-rajaampat.com
INSTAGRAM_HANDLE=kalma.rajaampat
# Link profil lain untuk ikon sosial media di bagian "Kata tamu" (kosongkan = ikon tampil tanpa link)
FACEBOOK_URL=
TIKTOK_URL=
GOOGLE_BUSINESS_URL=
# Token Instagram (API resmi) untuk menampilkan komentar tamu dari Instagram; lihat DEPLOY.md langkah 11
INSTAGRAM_ACCESS_TOKEN=

# Kode verifikasi Google Search Console (isi bagian content="…" dari tag HTML yang diberikan Google)
GOOGLE_SITE_VERIFICATION=

# Password halaman /admin (user: admin). Kosongkan untuk menonaktifkan admin.
ADMIN_PASSWORD=

# ---- Database MySQL (data customer & permintaan) ----
# Di Hostinger: hPanel → Databases → MySQL Databases. Kosongkan semua untuk memakai file JSON lokal (khusus development).
DB_HOST=localhost
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASSWORD=
# Opsional: socket MySQL lokal jika koneksi lewat DB_HOST gagal (mis. /var/lib/mysql/mysql.sock)
# DB_SOCKET=
# Atau satu baris: DATABASE_URL=mysql://user:password@host:3306/nama_database
# Migrasi tabel otomatis saat server start (default true)
# DB_AUTO_MIGRATE=true

# Folder file JSON jika tidak memakai MySQL (default: ./data)
# DATA_DIR=./data

# Pembayaran online Midtrans (Snap). Kosongkan untuk menerima pesanan lewat WhatsApp saja.
# Ambil dari dashboard Midtrans → Settings → Access Keys (sandbox dulu untuk uji coba).
# MIDTRANS_SERVER_KEY=
# MIDTRANS_CLIENT_KEY=
# MIDTRANS_IS_PRODUCTION=false
# Persentase yang dibayar online (100 = lunas, mis. 30 = DP 30%)
# PAYMENT_DEPOSIT_PERCENT=100
