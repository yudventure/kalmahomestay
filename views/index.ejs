<!doctype html>
<html lang="<%= lang %>">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title><%= t('meta.title') %></title>
<meta name="description" content="<%= t('meta.desc') %>">
<link rel="canonical" href="<%= siteUrl %><%= path %>">
<link rel="alternate" hreflang="id" href="<%= siteUrl %>/id">
<link rel="alternate" hreflang="en" href="<%= siteUrl %>/">
<link rel="alternate" hreflang="x-default" href="<%= siteUrl %>/">
<meta name="theme-color" content="#FFFFFF">
<% if (googleVerification) { %><meta name="google-site-verification" content="<%= googleVerification %>"><% } %>
<meta property="og:type" content="website">
<meta property="og:title" content="Kalma Raja Ampat · Slow down, Raja Ampat style.">
<meta property="og:url" content="<%= siteUrl %><%= path %>">
<meta property="og:locale" content="<%= lang === 'en' ? 'en_US' : 'id_ID' %>">
<meta property="og:description" content="<%= t('hero.lead') %>">
<meta property="og:image" content="<%= siteUrl %>/brand/assets/kalma-logo-original.png">
<link rel="icon" href="/brand/assets/favicon.ico" sizes="any">
<link rel="icon" href="/brand/assets/favicon-32.png" type="image/png" sizes="32x32">
<link rel="apple-touch-icon" href="/brand/assets/apple-touch-icon.png">
<link rel="preload" href="/fonts/jakarta-latin.woff2" as="font" type="font/woff2" crossorigin>
<link rel="preload" href="/fonts/fraunces-latin.woff2" as="font" type="font/woff2" crossorigin>
<link rel="preload" href="/img/hero-1.jpg" as="image" fetchpriority="high">
<link rel="stylesheet" href="/brand/tokens.css?v=<%= v %>">
<link rel="stylesheet" href="/css/style.css?v=<%= v %>">
<link rel="stylesheet" href="/css/home.css?v=<%= v %>">
<link rel="stylesheet" href="/css/datepicker.css?v=<%= v %>">
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "LodgingBusiness",
  "name": "Kalma Raja Ampat",
  "description": "<%= t('meta.desc') %>",
  "image": "<%= siteUrl %>/brand/assets/kalma-logo-original.png",
  "url": "<%= siteUrl %>/",
  "telephone": "+<%= contact.whatsapp %>",
  "email": "<%= contact.email %>",
  "address": { "@type": "PostalAddress", "addressRegion": "Papua Barat Daya", "addressLocality": "Raja Ampat", "addressCountry": "ID" }
}
</script>
</head>
<body class="home">
<a class="skip" href="#main"><%- t('skip') %></a>
<%
  const ROOM_KEYS = ['r1', 'r2', 'r3'];
  const ROOM_PH = ['ph-lagoon', 'ph-beach', 'ph-family'];
  const EXP_PH = ['ph-reef', 'ph-karst', 'ph-deep', 'ph-jungle', 'ph-house', 'ph-dusk'];
  const realReviews = (Array.isArray(t('reviews')) ? t('reviews') : []).concat(igReviews || []);
  // Until there are real guest stories, show clearly labelled sample bubbles so the section is not empty.
  const isSample = !realReviews.length;
  const reviews = isSample ? (Array.isArray(t('rev.samples')) ? t('rev.samples') : []) : realReviews;
  // Social bubbles beside the guest stories, largest first; a network without a link in hPanel is shown but not clickable.
  const socials = [
    { key: 'instagram', name: 'Instagram', url: contact.instagramUrl,
      svg: '<svg viewBox="0 0 24 24" aria-hidden="true"><defs><radialGradient id="ig-grad" cx="30%" cy="107%" r="150%"><stop offset="0" stop-color="#fdf497"/><stop offset=".05" stop-color="#fdf497"/><stop offset=".45" stop-color="#fd5949"/><stop offset=".6" stop-color="#d6249f"/><stop offset=".9" stop-color="#285AEB"/></radialGradient></defs><rect width="24" height="24" rx="6.5" fill="url(#ig-grad)"/><rect x="5" y="5" width="14" height="14" rx="4.2" fill="none" stroke="#fff" stroke-width="1.8"/><circle cx="12" cy="12" r="3.3" fill="none" stroke="#fff" stroke-width="1.8"/><circle cx="16.4" cy="7.6" r="1.05" fill="#fff"/></svg>' },
    { key: 'google', name: 'Google', url: contact.googleUrl,
      svg: '<svg viewBox="0 0 48 48" aria-hidden="true"><path fill="#EA4335" d="M24 9.5c3.54 0 6.71 1.22 9.21 3.6l6.85-6.85C35.9 2.38 30.47 0 24 0 14.62 0 6.51 5.38 2.56 13.22l7.98 6.19C12.43 13.72 17.74 9.5 24 9.5z"/><path fill="#4285F4" d="M46.98 24.55c0-1.57-.15-3.09-.38-4.55H24v9.02h12.94c-.58 2.96-2.26 5.48-4.78 7.18l7.73 6c4.51-4.18 7.09-10.36 7.09-17.65z"/><path fill="#FBBC05" d="M10.53 28.59c-.48-1.45-.76-2.99-.76-4.59s.27-3.14.76-4.59l-7.98-6.19C.92 16.46 0 20.12 0 24c0 3.88.92 7.54 2.56 10.78l7.97-6.19z"/><path fill="#34A853" d="M24 48c6.48 0 11.93-2.13 15.89-5.81l-7.73-6c-2.15 1.45-4.92 2.3-8.16 2.3-6.26 0-11.57-4.22-13.47-9.91l-7.98 6.19C6.51 42.62 14.62 48 24 48z"/></svg>' },
    { key: 'facebook', name: 'Facebook', url: contact.facebookUrl,
      svg: '<svg viewBox="0 0 24 24" aria-hidden="true"><path fill="#1877F2" d="M24 12.07C24 5.4 18.63 0 12 0S0 5.4 0 12.07C0 18.1 4.39 23.1 10.13 24v-8.44H7.08v-3.49h3.04V9.41c0-3.02 1.8-4.7 4.54-4.7 1.31 0 2.68.24 2.68.24v2.97h-1.51c-1.49 0-1.96.93-1.96 1.89v2.26h3.33l-.53 3.49h-2.8V24C19.62 23.1 24 18.1 24 12.07z"/></svg>' },
    { key: 'tiktok', name: 'TikTok', url: contact.tiktokUrl,
      svg: (function () { const d = 'M19.59 6.69a4.83 4.83 0 0 1-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 0 1-5.2 1.74 2.89 2.89 0 0 1 2.31-4.64 2.93 2.93 0 0 1 .88.13V9.4a6.84 6.84 0 0 0-1-.05A6.33 6.33 0 0 0 5 20.1a6.34 6.34 0 0 0 10.86-4.43v-7a8.16 8.16 0 0 0 4.77 1.52v-3.4a4.85 4.85 0 0 1-1-.1z';
        return '<svg viewBox="0 0 24 24" aria-hidden="true"><path fill="#25F4EE" transform="translate(-.7 -.7)" d="' + d + '"/><path fill="#FE2C55" transform="translate(.7 .7)" d="' + d + '"/><path fill="#111" d="' + d + '"/></svg>'; })() },
  ];
  const waText = encodeURIComponent(lang === 'en' ? 'Hi Kalma! I stayed with you and would like to share my story:' : 'Halo Kalma! Saya pernah menginap dan ingin berbagi cerita:');
%>

<!-- ============================== NAV ============================== -->
<%- include('partials/site-nav', { current: 'home' }) %>

<main id="main">
<div class="sea" aria-hidden="true"><span class="sea__side sea__side--l"></span><span class="sea__side sea__side--r"></span></div>

<!-- ============================== HERO ============================== -->
<div class="fold">
<section class="hero">
  <div class="wrap hero__in">
    <div class="hero__text">
      <h1><%- t('hero.title') %></h1>
      <p class="lead"><%- t('hero.lead') %></p>
    </div>
    <div class="mosaic" aria-hidden="true">
      <span class="mosaic__blob"></span>
      <% ['ph-karst', 'ph-house', 'ph-reef', 'ph-sunrise'].forEach(function (ph, i) { const slot = 'hero-' + (i + 1), clip = video(slot); %>
      <div class="photo <%= ph %> m<%= i + 1 %>" style="<%= photo(slot) %>">
        <% if (clip) { %><video class="tile__video" autoplay muted loop playsinline preload="auto" disablepictureinpicture<% if (photo.url(slot)) { %> poster="<%= photo.url(slot) %>"<% } %>><% if (clip.webm) { %><source src="<%= clip.webm %>" type="video/webm"><% } %><% if (clip.mp4) { %><source src="<%= clip.mp4 %>" type="video/mp4"><% } %></video><% } %>
      </div>
      <% }) %>
    </div>
    <form class="search" id="quick" method="get" action="<%= bookPath %>">
      <div class="search__f">
        <label for="q-in"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="5" width="18" height="16" rx="3"/><path d="M3 10h18M8 3v4M16 3v4"/></svg><%- t('form.checkin') %></label>
        <input id="q-in" type="date" name="checkin" data-dp="range" data-dp-end="q-out">
      </div>
      <div class="search__f">
        <label for="q-out"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="5" width="18" height="16" rx="3"/><path d="M3 10h18M8 3v4M16 3v4"/></svg><%- t('form.checkout') %></label>
        <input id="q-out" type="date" name="checkout">
      </div>
      <div class="search__f">
        <label for="q-g"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="8" r="4"/><path d="M4 21c1-4 4-6 8-6s7 2 8 6"/></svg><%- t('form.guests') %></label>
        <select id="q-g" name="guests"><% [1, 2, 3, 4, 5].forEach(function (g) { %><option<%= g === 2 ? ' selected' : '' %>><%= g %></option><% }) %></select>
      </div>
      <button class="btn btn--cta" type="submit"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="5" width="18" height="16" rx="3"/><path d="M3 10h18M8 3v4M16 3v4M9 15l2 2 4-4"/></svg><%- t('nav.book') %></button>
      <p class="search__hint"><%- t('hero.hint') %></p>
    </form>
  </div>
  <div class="shore" aria-hidden="true">
    <svg class="wave" viewBox="0 0 1440 90" preserveAspectRatio="none">
      <path d="M0 50 C 240 10, 520 10, 760 44 S 1220 96, 1440 36 L1440 90 L0 90 Z" fill="#4B8AA5"/>
      <path d="M0 70 C 280 40, 560 46, 820 68 S 1260 100, 1440 62 L1440 90 L0 90 Z" fill="#224866"/>
      <path class="shore__line" d="M0 50 C 240 10, 520 10, 760 44 S 1220 96, 1440 36" fill="none"/>
    </svg>
    <svg class="crab" viewBox="0 0 64 48" width="52" height="39">
      <g class="crab__legs crab__legs--a" fill="none" stroke="#E07A5F" stroke-width="2.6" stroke-linecap="round"><path d="M30 36 L24 46"/><path d="M41 37 L43 46"/></g>
      <g class="crab__legs crab__legs--b" fill="none" stroke="#E07A5F" stroke-width="2.6" stroke-linecap="round"><path d="M35 37 L31 46"/><path d="M46 36 L51 45"/></g>
      <path d="M36 38 C44 41 52 38 54 32 C50 27 42 27 37 30 Z" fill="#E07A5F" stroke="#224866" stroke-width="2" stroke-linejoin="round"/>
      <path class="crab__claw" d="M51 32 C56 25 63 29 61 35 C59 40 52 39 52 34" fill="#E07A5F" stroke="#224866" stroke-width="2" stroke-linejoin="round"/>
      <path d="M46 29 L47 19 M50 29 L54 20" stroke="#224866" stroke-width="2" stroke-linecap="round"/>
      <circle cx="47" cy="18" r="2.3" fill="#224866"/><circle cx="54.5" cy="19" r="2.3" fill="#224866"/>
      <path d="M8 35 C4 19 16 6 30 8 C43 10 48 24 41 35 Z" fill="#EDE0B5" stroke="#224866" stroke-width="2.2" stroke-linejoin="round"/>
      <path d="M25 31 C17 29 17 18 25 16 C32 15 35 22 30 25 C27 27 24 24 26 22" fill="none" stroke="#224866" stroke-width="2" stroke-linecap="round"/>
    </svg>
  </div>
</section>

<section class="facts" aria-label="<%= t('hero.eyebrow') %>">
  <div class="wrap facts__in">
    <% const FACT_ICONS = [
         '<path d="M7 3v8M5 3v5a2 2 0 0 0 4 0V3M7 11v10M17 21V3c-2.2 0-4 2.7-4 6.5V13h4"/>',
         '<path d="M3 15c2 0 2-1.5 4.5-1.5S10 15 12 15s2-1.5 4.5-1.5S19 15 21 15M3 19c2 0 2-1.5 4.5-1.5S10 19 12 19s2-1.5 4.5-1.5S19 19 21 19"/><path d="M8 11c1.5-2.5 4-3.5 6.5-2.5L17 6l-.3 3.2c.8.9.8 2 0 2.8"/><circle cx="14.5" cy="9.7" r=".6"/>',
         '<path d="M3 15h18l-2.5 4.5h-13z"/><path d="M6 15V9.5h8.5L18 15M9 9.5V6h3"/><path d="M2 21.5c1.7 0 1.7-1 3.4-1s1.7 1 3.4 1 1.7-1 3.4-1 1.7 1 3.4 1 1.7-1 3.4-1"/>',
         '<path d="M3 11.5 12 4l9 7.5M5.5 9.5V20h13V9.5"/><path d="M12 17.5s-3-1.8-3-3.8a1.6 1.6 0 0 1 3-.8 1.6 1.6 0 0 1 3 .8c0 2-3 3.8-3 3.8z"/>',
       ]; %>
    <% for (let i = 1; i <= 4; i++) { %><div class="fact"><span class="fact__ic" aria-hidden="true"><svg viewBox="0 0 24 24"><%- FACT_ICONS[i - 1] %></svg></span><p><b><%- t('facts.' + i + 'a') %></b><span><%- t('facts.' + i + 'b') %></span></p></div><% } %>
  </div>
</section>
</div>

<% if (partners.length) { %>
<div class="partners" role="region" aria-label="Partner Kalma">
  <div class="partners__viewport">
  <% let loop = partners.slice(); while (loop.length < 6) loop = loop.concat(partners); /* at least two screens of three */ %>
  <div class="partners__track" style="--n: <%= loop.length %>">
    <% [0, 1].forEach(function (copy) { %>
    <ul class="partners__list"<%- copy ? ' aria-hidden="true"' : '' %>>
      <% loop.forEach(function (p, i) { %><li<%- !copy && i >= partners.length ? ' aria-hidden="true"' : '' %>>
        <% if (p.logo) { %><img class="partners__logo" src="<%= p.logo %>" alt="" loading="lazy" height="40"><% } %>
        <span class="partners__name"><%= p.name %></span>
      </li><% }) %>
    </ul>
    <% }) %>
  </div>
  </div>
</div>
<% } %>

<!-- ============================== EXPERIENCES (categories) ============================== -->
<section class="sec" id="pengalaman">
  <div class="wrap">
    <div class="sec__head reveal">
      <p class="eyebrow"><%- t('exp.eyebrow') %></p>
      <h2><%- t('exp.title') %></h2>
      <p class="sub"><%- t('exp.lead') %></p>
    </div>
    <ul class="cats">
      <% for (let i = 1; i <= 6; i++) { %>
      <li class="cat reveal">
        <div class="photo cat__img <%= EXP_PH[i - 1] %>" style="<%= photo('exp-' + i) %>"></div>
        <h3><%- t('e' + i + '.t') %></h3>
        <p><%- t('e' + i + '.d') %></p>
      </li>
      <% } %>
    </ul>
  </div>
</section>

<!-- ============================== KALMA SERVICES ============================== -->
<%
  const tick = '<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12.5l4.5 4.5L19 7.5"/></svg>';
%>
<section class="sec sec--tint" id="kamar">
  <div class="wrap">
    <div class="sec__head reveal">
      <p class="eyebrow"><%- t('svc.eyebrow') %></p>
      <h2><%- t('svc.title') %></h2>
      <p class="sub"><span class="svc-hint"><%- t('svc.lead') %></span><span class="svc-hint--touch"><%- t('svc.leadTouch') %></span></p>
    </div>
    <div class="svc-grid" id="services">
      <article class="svc is-active" data-svc="homestay" tabindex="0" aria-labelledby="svc1">
        <div class="photo svc__bg ph-house" style="<%= photo('svc-homestay') || photo('hero-2') %>"></div>
        <div class="svc__body">
          <span class="svc__n">01</span>
          <h3 id="svc1"><%- t('s1.t') %></h3>
          <p class="svc__lead"><%- t('s1.d') %></p>
          <div class="svc__more">
            <ul class="svc__rooms">
              <% rooms.forEach(function (r, i) { %>
              <li><a href="<%= bookPath %>?room=<%= r.id %>" class="svc__room">
                <span><b><%- t(r.nameKey) %></b><small><%- t(ROOM_KEYS[i] + '.m1') %> · <%- t(ROOM_KEYS[i] + '.badge') %></small></span>
                <span class="svc__price"><b><%= rupiah(r.price) %></b><small><%- t('r.per') %></small></span>
              </a></li>
              <% }) %>
            </ul>
            <a href="<%= servicePath('homestay') %>" class="btn btn--cta btn--sm"><%- t('s1.more') %></a>
            <p class="svc__note"><%- t('rooms.note') %></p>
          </div>
        </div>
      </article>
      <% [['s2', 'svc-diving', 'hero-4', 'ph-reef', 'diving'], ['s3', 'svc-trips', 'hero-1', 'ph-karst', 'trip']].forEach(function (s, n) { %>
      <article class="svc" data-svc="<%= s[4] %>" tabindex="0" aria-labelledby="svc<%= n + 2 %>">
        <div class="photo svc__bg <%= s[3] %>" style="<%= photo(s[1]) || photo(s[2]) %>"></div>
        <div class="svc__body">
          <span class="svc__n">0<%= n + 2 %></span>
          <h3 id="svc<%= n + 2 %>"><%- t(s[0] + '.t') %></h3>
          <p class="svc__lead"><%- t(s[0] + '.d') %></p>
          <div class="svc__more">
            <ul class="svc__list"><% for (let k = 1; k <= 4; k++) { %><li><%- tick %><%- t(s[0] + '.i' + k) %></li><% } %></ul>
            <a href="<%= servicePath(s[4]) %>" class="btn btn--light btn--sm"><%- t(s[0] + '.more') %></a>
          </div>
        </div>
      </article>
      <% }) %>
    </div>
  </div>
</section>

<!-- ============================== WHY KALMA (feature band) ============================== -->
<section class="sec sec--tight">
  <div class="wrap">
    <div class="band reveal">
      <ul class="band__list">
        <li>
          <span class="band__ic"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3l8 3v6c0 5-3.5 8-8 9-4.5-1-8-4-8-9V6z"/><path d="M8.5 12l2.5 2.5 4.5-5"/></svg></span>
          <div><b><%- t('feat.1t') %></b><span><%- t('feat.1d') %></span></div>
        </li>
        <li>
          <span class="band__ic"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 14v-2a8 8 0 0 1 16 0v2"/><rect x="3" y="14" width="4" height="6" rx="2"/><rect x="17" y="14" width="4" height="6" rx="2"/></svg></span>
          <div><b><%- t('feat.2t') %></b><span><%- t('feat.2d') %></span></div>
        </li>
        <li>
          <span class="band__ic"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 12V4h8l10 10-8 8z"/><circle cx="7.5" cy="8.5" r="1.5"/></svg></span>
          <div><b><%- t('feat.3t') %></b><span><%- t('feat.3d') %></span></div>
        </li>
      </ul>
      <div class="photo band__img ph-sunrise" style="<%= photo('feature') %>" role="img" aria-label="<%= t('hero.badge') %>"></div>
    </div>
  </div>
</section>

<!-- ============================== REVIEWS ============================== -->
<section class="sec" id="ulasan">
  <div class="wrap">
    <div class="sec__head reveal">
      <p class="eyebrow"><%- t('rev.eyebrow') %></p>
      <h2><%- t('rev.title') %></h2>
      <p class="sub"><%- t('rev.lead') %></p>
    </div>
    <div class="reviews reveal">
      <div class="reviews__art">
        <div class="socials">
          <span class="dots" aria-hidden="true"></span>
          <span class="socials__ring" aria-hidden="true"></span>
          <% socials.forEach(function (s) { %>
          <% if (s.url) { %><a class="soc soc--<%= s.key %>" href="<%= s.url %>" target="_blank" rel="noopener" aria-label="Kalma <%= lang === 'en' ? 'on' : 'di' %> <%= s.name %>"><% } else { %><span class="soc soc--<%= s.key %>" aria-hidden="true"><% } %>
            <%- s.svg %>
          <%- s.url ? '</a>' : '</span>' %>
          <% }) %>
        </div>
      </div>
      <% if (reviews.length) {
           // Two columns scrolling in opposite directions; each track holds the list twice for a seamless loop,
           // and short lists are repeated so a loop is always taller than the window.
           var loop = reviews.slice(); while (loop.length < 6) loop = loop.concat(reviews);
           var half = Math.ceil(loop.length / 2);
           var cols = [loop, loop.slice(half).concat(loop.slice(0, half))];
           var initial = function (n) { var w = String(n || '?').replace(/^@/, '').split(' '); return (isSample ? w[w.length - 1] : w[0]).charAt(0).toUpperCase(); };
           var kindLabel = { reel: 'Reels', post: lang === 'en' ? 'Post' : 'Foto' }; %>
      <div class="reviews__wall">
      <div class="bubbles<%= isSample ? ' bubbles--sample' : '' %>" style="--dur: <%= Math.max(24, loop.length * 5) %>s">
        <% cols.forEach(function (col, ci) { %>
        <div class="bubbles__col<%= ci ? ' bubbles__col--down' : '' %>"<%- ci ? ' aria-hidden="true"' : '' %>>
          <div class="bubbles__track">
          <% [0, 1].forEach(function (copy) { %>
            <ul class="bubbles__list"<%- copy ? ' aria-hidden="true"' : '' %>>
            <% col.forEach(function (r, i) { var repeat = ci || copy || i >= reviews.length; %>
              <li class="bubble"<%- !ci && !copy && repeat ? ' aria-hidden="true"' : '' %>>
                <span class="bubble__av" aria-hidden="true"><%= initial(r.name) %></span>
                <div class="bubble__body">
                  <p class="bubble__who"><b><%= r.name %></b>
                    <% if (r.url) { %><a class="bubble__tag" href="<%= r.url %>" target="_blank" rel="noopener nofollow"<%- repeat ? ' tabindex="-1"' : '' %>><%= kindLabel[r.kind] || r.from %></a><% } else if (isSample) { %><span class="bubble__tag bubble__tag--sample"><%= t('rev.sampleTag') %></span><% } else if (r.kind || r.from) { %><span class="bubble__tag"><%= kindLabel[r.kind] || r.from %></span><% } %>
                    <% if (r.rating) { %><span class="stars" aria-label="<%= r.rating %>/5"><%= '★'.repeat(Math.max(0, Math.min(5, r.rating | 0))) %></span><% } %></p>
                  <p class="bubble__text"><%= r.quote %></p>
                </div>
              </li>
            <% }) %>
            </ul>
          <% }) %>
          </div>
        </div>
        <% }) %>
      </div>
      <% if (isSample) { %>
      <p class="reviews__note"><%- t('rev.sampleNote') %> <a href="https://wa.me/<%= contact.whatsapp %>?text=<%= waText %>" target="_blank" rel="noopener"><%- t('rev.cta') %></a></p>
      <% } %>
      </div>
      <% } else { %>
      <div class="quote">
        <svg class="quote__mark" viewBox="0 0 48 36" aria-hidden="true"><path d="M0 36V22C0 9 7 2 19 0l2 5c-7 2-10 7-10 13h9v18zm27 0V22C27 9 34 2 46 0l2 5c-7 2-10 7-10 13h9v18z"/></svg>
        <p class="quote__empty"><%- t('rev.empty') %></p>
        <a class="btn btn--soft btn--sm" href="https://wa.me/<%= contact.whatsapp %>?text=<%= waText %>" target="_blank" rel="noopener"><%- t('rev.cta') %></a>
      </div>
      <% } %>
    </div>
  </div>
</section>

<!-- ============================== GETTING THERE ============================== -->
<section class="sec sec--tint" id="lokasi">
  <div class="wrap">
    <div class="sec__head reveal">
      <p class="eyebrow"><%- t('loc.eyebrow') %></p>
      <h2><%- t('loc.title') %></h2>
      <p class="sub"><%- t('loc.lead') %></p>
    </div>
    <ol class="route">
      <li class="reveal"><span class="route__n">1</span><h3><%- t('l1.t') %></h3><p><%- t('l1.d') %></p></li>
      <li class="reveal"><span class="route__n">2</span><h3><%- t('l2.t') %></h3><p><%- t('l2.d') %></p></li>
      <li class="reveal"><span class="route__n">3</span><h3><%- t('l3.t') %></h3><p><%- t('l3.d') %></p></li>
    </ol>
    <div class="tip reveal">
      <img src="/brand/assets/kalma-icon-deepsea.png" alt="" width="44" height="44">
      <p><%- t('loc.tip') %></p>
    </div>
  </div>
</section>

<!-- ============================== FAQ ============================== -->
<section class="sec" id="faq">
  <div class="wrap faq">
    <div class="sec__head reveal">
      <p class="eyebrow">FAQ</p>
      <h2><%- t('faq.title') %></h2>
      <p class="sub"><%- t('faq.lead') %></p>
    </div>
    <div class="faq__list">
      <% for (let i = 1; i <= 6; i++) { %>
      <details class="reveal"><summary><%- t('q' + i + '.q') %></summary><p><%- t('q' + i + '.a' + (i === 3 && pay.enabled ? '_online' : '')) %></p></details>
      <% } %>
    </div>
  </div>
</section>

</main>

<!-- ============================== FOOTER ============================== -->
<%- include('partials/site-foot') %>

<script id="kalma-config" type="application/json"><%- clientConfig %></script>
<script src="/js/datepicker.js?v=<%= v %>" defer></script>
<script src="/js/main.js?v=<%= v %>" defer></script>
</body>
</html>
