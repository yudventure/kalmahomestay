<!doctype html>
<html lang="<%= lang %>">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title><%= t('meta.title') %></title>
<meta name="description" content="<%= t('meta.desc') %>">
<link rel="canonical" href="<%= siteUrl %><%= path %>">
<link rel="alternate" hreflang="id" href="<%= siteUrl %>/">
<link rel="alternate" hreflang="en" href="<%= siteUrl %>/en">
<link rel="alternate" hreflang="x-default" href="<%= siteUrl %>/">
<meta name="theme-color" content="#FFFFFF">
<% if (googleVerification) { %><meta name="google-site-verification" content="<%= googleVerification %>"><% } %>
<meta property="og:type" content="website">
<meta property="og:title" content="Kalma Raja Ampat · Slow down, Raja Ampat style.">
<meta property="og:url" content="<%= siteUrl %><%= path %>">
<meta property="og:locale" content="<%= lang === 'en' ? 'en_US' : 'id_ID' %>">
<meta property="og:description" content="<%= t('hero.lead') %>">
<meta property="og:image" content="<%= siteUrl %>/brand/assets/kalma-logo-original.png">
<link rel="icon" href="/brand/assets/favicon.ico" sizes="any">
<link rel="icon" href="/brand/assets/favicon-32.png" type="image/png" sizes="32x32">
<link rel="apple-touch-icon" href="/brand/assets/apple-touch-icon.png">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght,SOFT@0,9..144,300..700,100;1,9..144,300..700,100&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/brand/tokens.css?v=<%= v %>">
<link rel="stylesheet" href="/css/style.css?v=<%= v %>">
<link rel="stylesheet" href="/css/home.css?v=<%= v %>">
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "LodgingBusiness",
  "name": "Kalma Raja Ampat",
  "description": "<%= t('meta.desc') %>",
  "image": "<%= siteUrl %>/brand/assets/kalma-logo-original.png",
  "url": "<%= siteUrl %>/",
  "telephone": "+<%= contact.whatsapp %>",
  "email": "<%= contact.email %>",
  "address": { "@type": "PostalAddress", "addressRegion": "Papua Barat Daya", "addressLocality": "Raja Ampat", "addressCountry": "ID" }
}
</script>
</head>
<body class="home">
<a class="skip" href="#main"><%- t('skip') %></a>
<%
  const ROOM_KEYS = ['r1', 'r2', 'r3'];
  const ROOM_PH = ['ph-lagoon', 'ph-beach', 'ph-family'];
  const EXP_PH = ['ph-reef', 'ph-karst', 'ph-deep', 'ph-jungle', 'ph-house', 'ph-dusk'];
  const reviews = Array.isArray(t('reviews')) ? t('reviews') : [];
  const waText = encodeURIComponent(lang === 'en' ? 'Hi Kalma! I stayed with you and would like to share my story:' : 'Halo Kalma! Saya pernah menginap dan ingin berbagi cerita:');
%>

<!-- ============================== NAV ============================== -->
<header class="nav" id="top">
  <div class="wrap nav__in">
    <a href="<%= home %>" class="nav__logo" aria-label="Kalma Raja Ampat"><img src="/brand/assets/kalma-wordmark.png" alt="Kalma" width="110" height="53"></a>
    <nav class="nav__links" id="menu" aria-label="Menu">
      <a href="#top" aria-current="page"><%- t('nav.home') %></a>
      <a href="#kamar"><%- t('nav.rooms') %></a>
      <a href="#pengalaman"><%- t('nav.exp') %></a>
      <a href="#lokasi"><%- t('nav.loc') %></a>
      <a href="#faq"><%- t('nav.faq') %></a>
    </nav>
    <div class="nav__right">
      <div class="lang" role="group" aria-label="Bahasa / Language">
        <a href="/" hreflang="id" lang="id"<%- lang === 'id' ? ' aria-current="page"' : '' %>>ID</a>
        <a href="/en" hreflang="en" lang="en"<%- lang === 'en' ? ' aria-current="page"' : '' %>>EN</a>
      </div>
      <a href="#pesan" class="btn btn--cta btn--sm nav__cta"><%- t('nav.book') %></a>
      <button class="nav__burger" type="button" aria-controls="menu" aria-expanded="false" aria-label="Menu"><span></span><span></span></button>
    </div>
  </div>
</header>

<main id="main">

<!-- ============================== HERO ============================== -->
<div class="fold">
<section class="hero">
  <div class="wrap hero__in">
    <div class="hero__text reveal">
      <h1><%- t('hero.title') %></h1>
      <p class="lead"><%- t('hero.lead') %></p>
    </div>
    <div class="mosaic reveal" aria-hidden="true">
      <span class="mosaic__blob"></span>
      <% ['ph-karst', 'ph-house', 'ph-reef', 'ph-sunrise'].forEach(function (ph, i) { const slot = 'hero-' + (i + 1), clip = video(slot); %>
      <div class="photo <%= ph %> m<%= i + 1 %>" style="<%= photo(slot) %>">
        <% if (clip) { %><video class="tile__video" muted loop playsinline preload="none" disablepictureinpicture<% if (clip.webm) { %> data-webm="<%= clip.webm %>"<% } %><% if (clip.mp4) { %> data-mp4="<%= clip.mp4 %>"<% } %>></video><% } %>
      </div>
      <% }) %>
    </div>
    <form class="search reveal" id="quick" novalidate>
      <div class="search__f">
        <label for="q-in"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="5" width="18" height="16" rx="3"/><path d="M3 10h18M8 3v4M16 3v4"/></svg><%- t('form.checkin') %></label>
        <input id="q-in" type="date" required>
      </div>
      <div class="search__f">
        <label for="q-out"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="5" width="18" height="16" rx="3"/><path d="M3 10h18M8 3v4M16 3v4"/></svg><%- t('form.checkout') %></label>
        <input id="q-out" type="date" required>
      </div>
      <div class="search__f">
        <label for="q-g"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="8" r="4"/><path d="M4 21c1-4 4-6 8-6s7 2 8 6"/></svg><%- t('form.guests') %></label>
        <select id="q-g"><% guestOptions.forEach(function (g) { %><option<%= g === '2' ? ' selected' : '' %>><%= g %></option><% }) %></select>
      </div>
      <button class="btn btn--cta" type="submit"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="M20 20l-4-4"/></svg><%- t('form.check') %></button>
      <p class="search__hint"><%- t('hero.hint') %></p>
    </form>
  </div>
  <svg class="wave" viewBox="0 0 1440 90" preserveAspectRatio="none" aria-hidden="true">
    <path d="M0 50 C 240 10, 520 10, 760 44 S 1220 96, 1440 36 L1440 90 L0 90 Z" fill="#4B8AA5"/>
    <path d="M0 70 C 280 40, 560 46, 820 68 S 1260 100, 1440 62 L1440 90 L0 90 Z" fill="#224866"/>
  </svg>
</section>

<section class="facts" aria-label="<%= t('hero.eyebrow') %>">
  <div class="wrap facts__in">
    <% for (let i = 1; i <= 4; i++) { %><div><b><%- t('facts.' + i + 'a') %></b><span><%- t('facts.' + i + 'b') %></span></div><% } %>
  </div>
</section>
</div>

<!-- ============================== EXPERIENCES (categories) ============================== -->
<section class="sec" id="pengalaman">
  <div class="wrap">
    <div class="sec__head reveal">
      <p class="eyebrow"><%- t('exp.eyebrow') %></p>
      <h2><%- t('exp.title') %></h2>
      <p class="sub"><%- t('exp.lead') %></p>
    </div>
    <ul class="cats">
      <% for (let i = 1; i <= 6; i++) { %>
      <li class="cat reveal">
        <div class="photo cat__img <%= EXP_PH[i - 1] %>" style="<%= photo('exp-' + i) %>"></div>
        <h3><%- t('e' + i + '.t') %></h3>
        <p><%- t('e' + i + '.d') %></p>
      </li>
      <% } %>
    </ul>
  </div>
</section>

<!-- ============================== ROOMS (cards carousel) ============================== -->
<section class="sec sec--tint" id="kamar">
  <div class="wrap">
    <div class="sec__head sec__head--row reveal">
      <div>
        <p class="eyebrow"><%- t('rooms.eyebrow') %></p>
      <h2><%- t('rooms.title') %></h2>
        <p class="sub"><%- t('rooms.lead') %></p>
      </div>
      <div class="arrows" data-for="rooms-track">
        <button type="button" class="arrow" data-dir="-1" aria-label="<%= t('car.prev') %>"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 6l-6 6 6 6"/></svg></button>
        <button type="button" class="arrow arrow--fill" data-dir="1" aria-label="<%= t('car.next') %>"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 6l6 6-6 6"/></svg></button>
      </div>
    </div>
    <div class="track" id="rooms-track">
      <% rooms.forEach(function (r, i) { const k = ROOM_KEYS[i]; %>
      <article class="card reveal">
        <div class="photo card__img <%= ROOM_PH[i] %>" style="<%= photo('room-' + r.id) %>" role="img" aria-label="<%= t(r.nameKey) %>">
          <span class="card__tag"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 21s-7-6.2-7-11a7 7 0 0 1 14 0c0 4.8-7 11-7 11z"/><circle cx="12" cy="10" r="2.5"/></svg><%- t(k + '.badge') %></span>
        </div>
        <div class="card__body">
          <h3><%- t(r.nameKey) %></h3>
          <p class="card__meta"><%- t(k + '.m1') %> · <%- t(k + '.m2') %> · <%- t('r.meals') %></p>
          <p class="card__desc"><%- t(k + '.desc') %></p>
          <div class="card__foot">
            <div><b><%= rupiah(r.price) %></b><span><%- t('r.per') %></span></div>
            <a href="#pesan" class="btn btn--soft btn--sm" data-room="<%= r.id %>"><%- t('r.book') %></a>
          </div>
        </div>
      </article>
      <% }) %>
    </div>
    <p class="note"><%- t('rooms.note') %></p>
  </div>
</section>

<!-- ============================== WHY KALMA (feature band) ============================== -->
<section class="sec sec--tight">
  <div class="wrap">
    <div class="band reveal">
      <ul class="band__list">
        <li>
          <span class="band__ic"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3l8 3v6c0 5-3.5 8-8 9-4.5-1-8-4-8-9V6z"/><path d="M8.5 12l2.5 2.5 4.5-5"/></svg></span>
          <div><b><%- t('feat.1t') %></b><span><%- t('feat.1d') %></span></div>
        </li>
        <li>
          <span class="band__ic"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 14v-2a8 8 0 0 1 16 0v2"/><rect x="3" y="14" width="4" height="6" rx="2"/><rect x="17" y="14" width="4" height="6" rx="2"/></svg></span>
          <div><b><%- t('feat.2t') %></b><span><%- t('feat.2d') %></span></div>
        </li>
        <li>
          <span class="band__ic"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 12V4h8l10 10-8 8z"/><circle cx="7.5" cy="8.5" r="1.5"/></svg></span>
          <div><b><%- t('feat.3t') %></b><span><%- t('feat.3d') %></span></div>
        </li>
      </ul>
      <svg class="band__swirl" viewBox="0 0 120 120" aria-hidden="true"><path d="M8 100 C 10 60, 60 70, 50 40 S 90 10, 112 28"/><path d="M104 20l8 8-10 3"/></svg>
      <div class="photo band__img ph-sunrise" style="<%= photo('feature') %>" role="img" aria-label="<%= t('hero.badge') %>"></div>
    </div>
  </div>
</section>

<!-- ============================== REVIEWS ============================== -->
<section class="sec" id="ulasan">
  <div class="wrap">
    <div class="sec__head reveal">
      <p class="eyebrow"><%- t('rev.eyebrow') %></p>
      <h2><%- t('rev.title') %></h2>
      <p class="sub"><%- t('rev.lead') %></p>
    </div>
    <div class="reviews reveal">
      <div class="reviews__art" aria-hidden="true">
        <span class="leaf leaf--1"></span><span class="leaf leaf--2"></span><span class="dots"></span>
        <div class="photo reviews__photo ph-beach" style="<%= photo('review') %>"></div>
        <svg class="reviews__plane" viewBox="0 0 120 80"><path class="dash" d="M4 76 C 30 70, 50 54, 70 40"/><path class="plane" d="M78 24 L112 8 L96 42 L88 32 Z M88 32 L112 8"/></svg>
      </div>
      <div class="quote">
        <svg class="quote__mark" viewBox="0 0 48 36" aria-hidden="true"><path d="M0 36V22C0 9 7 2 19 0l2 5c-7 2-10 7-10 13h9v18zm27 0V22C27 9 34 2 46 0l2 5c-7 2-10 7-10 13h9v18z"/></svg>
        <% if (reviews.length) { %>
        <div class="quote__slides" aria-live="polite">
          <% reviews.forEach(function (r, i) { %>
          <figure class="quote__item"<%- i ? ' hidden' : '' %>>
            <blockquote><%= r.quote %></blockquote>
            <figcaption><b><%= r.name %></b><% if (r.from) { %><span><%= r.from %></span><% } %>
              <% if (r.rating) { %><span class="stars" aria-label="<%= r.rating %>/5"><%= '★'.repeat(Math.max(0, Math.min(5, r.rating | 0))) %></span><% } %></figcaption>
          </figure>
          <% }) %>
        </div>
        <% if (reviews.length > 1) { %>
        <div class="arrows quote__arrows">
          <button type="button" class="arrow" data-q="-1" aria-label="<%= t('car.prev') %>"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 6l-6 6 6 6"/></svg></button>
          <button type="button" class="arrow arrow--fill" data-q="1" aria-label="<%= t('car.next') %>"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 6l6 6-6 6"/></svg></button>
        </div>
        <% } %>
        <% } else { %>
        <p class="quote__empty"><%- t('rev.empty') %></p>
        <a class="btn btn--soft btn--sm" href="https://wa.me/<%= contact.whatsapp %>?text=<%= waText %>" target="_blank" rel="noopener"><%- t('rev.cta') %></a>
        <% } %>
      </div>
    </div>
  </div>
</section>

<!-- ============================== GETTING THERE ============================== -->
<section class="sec sec--tint" id="lokasi">
  <div class="wrap">
    <div class="sec__head reveal">
      <p class="eyebrow"><%- t('loc.eyebrow') %></p>
      <h2><%- t('loc.title') %></h2>
      <p class="sub"><%- t('loc.lead') %></p>
    </div>
    <ol class="route">
      <li class="reveal"><span class="route__n">1</span><h3><%- t('l1.t') %></h3><p><%- t('l1.d') %></p></li>
      <li class="reveal"><span class="route__n">2</span><h3><%- t('l2.t') %></h3><p><%- t('l2.d') %></p></li>
      <li class="reveal"><span class="route__n">3</span><h3><%- t('l3.t') %></h3><p><%- t('l3.d') %></p></li>
    </ol>
    <div class="tip reveal">
      <img src="/brand/assets/kalma-icon-deepsea.png" alt="" width="44" height="44">
      <p><%- t('loc.tip') %></p>
    </div>
  </div>
</section>

<!-- ============================== FAQ ============================== -->
<section class="sec" id="faq">
  <div class="wrap faq">
    <div class="sec__head reveal">
      <p class="eyebrow">FAQ</p>
      <h2><%- t('faq.title') %></h2>
      <p class="sub"><%- t('faq.lead') %></p>
    </div>
    <div class="faq__list">
      <% for (let i = 1; i <= 6; i++) { %>
      <details class="reveal"><summary><%- t('q' + i + '.q') %></summary><p><%- t('q' + i + '.a') %></p></details>
      <% } %>
    </div>
  </div>
</section>

<!-- ============================== BOOK ============================== -->
<section class="sec sec--tight" id="pesan">
  <div class="wrap">
    <div class="book reveal">
      <div class="book__text">
        <p class="eyebrow"><%- t('book.eyebrow') %></p>
        <h2><%- t('book.title') %></h2>
        <p class="sub"><%- t('book.lead') %></p>
        <ul class="contact">
          <li><span><%- t('book.wa') %></span><a href="https://wa.me/<%= contact.whatsapp %>" target="_blank" rel="noopener"><%= contact.whatsappDisplay %></a></li>
          <li><span>Email</span><a href="mailto:<%= contact.email %>"><%= contact.email %></a></li>
          <li><span>Instagram</span><a href="<%= contact.instagramUrl %>" target="_blank" rel="noopener"><%= contact.instagram %></a></li>
        </ul>
      </div>
      <form class="bform" id="bform" method="post" action="<%= base %>/inquiry#pesan" novalidate>
        <div class="bform__ok" hidden></div>
        <div class="hp" aria-hidden="true"><label for="b-website">Website</label><input id="b-website" name="website" tabindex="-1" autocomplete="off"></div>
        <div class="bform__row">
          <div class="field"><label for="b-name"><%- t('form.name') %></label><input id="b-name" name="name" autocomplete="name" maxlength="80" required value="<%= values.name %>"></div>
          <div class="field"><label for="b-contact"><%- t('form.contact') %></label><input id="b-contact" name="contact" maxlength="100" autocomplete="tel" inputmode="email" value="<%= values.contact %>"></div>
        </div>
        <div class="field"><label for="b-country"><%- t('form.country') %></label><input id="b-country" name="country" maxlength="80" value="<%= values.country %>"></div>
        <div class="bform__row">
          <div class="field"><label for="b-in"><%- t('form.checkin') %></label><input id="b-in" type="date" name="checkin" required value="<%= values.checkin %>"></div>
          <div class="field"><label for="b-out"><%- t('form.checkout') %></label><input id="b-out" type="date" name="checkout" required value="<%= values.checkout %>"></div>
        </div>
        <div class="bform__row">
          <div class="field"><label for="b-guests"><%- t('form.guests') %></label>
            <select id="b-guests" name="guests"><% guestOptions.forEach(function (g) { %><option<%= g === values.guests ? ' selected' : '' %>><%= g %></option><% }) %></select></div>
          <div class="field"><label for="b-room"><%- t('form.room') %></label>
            <select id="b-room" name="room">
              <option value=""><%- t('form.any') %></option>
              <% rooms.forEach(function (r) { %><option value="<%= r.id %>"<%= r.id === values.room ? ' selected' : '' %>><%- t(r.nameKey) %></option><% }) %>
            </select></div>
        </div>
        <div class="field"><label for="b-msg"><%- t('form.msg') %></label>
          <textarea id="b-msg" name="msg" rows="3" maxlength="1000" placeholder="<%= t('form.msg_ph') %>"><%= values.msg %></textarea></div>
        <p class="bform__err" role="alert" aria-live="polite"><%= formError %></p>
        <button type="submit" class="btn btn--cta btn--block"><%- t('form.send') %></button>
        <p class="bform__privacy"><%- t('form.privacy') %></p>
        <p class="bform__alt"><span><%- t('form.or') %></span> <a href="mailto:<%= contact.email %>" class="js-mail"><%- t('form.mail') %></a></p>
      </form>
    </div>
  </div>
</section>

</main>

<!-- ============================== FOOTER ============================== -->
<footer class="foot">
  <div class="wrap">
    <ul class="foot__perks">
      <li><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M21 12a9 9 0 0 1-13.5 7.8L3 21l1.2-4.4A9 9 0 1 1 21 12z"/></svg><%- t('fs.1') %></li>
      <li><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 11l9-7 9 7"/><path d="M5 10v10h14V10"/><path d="M10 20v-6h4v6"/></svg><%- t('fs.2') %></li>
      <li><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 19c8 0 14-6 14-14-8 0-14 6-14 14z"/><path d="M5 19l8-8"/></svg><%- t('fs.3') %></li>
      <li><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 12V4h8l10 10-8 8z"/><circle cx="7.5" cy="8.5" r="1.5"/></svg><%- t('fs.4') %></li>
    </ul>
    <div class="foot__mid">
      <img class="foot__logo" src="/brand/assets/kalma-logo-white.png" alt="Kalma Raja Ampat" width="130" height="76">
      <nav class="foot__nav" aria-label="Footer">
        <a href="#kamar"><%- t('nav.rooms') %></a><a href="#pengalaman"><%- t('nav.exp') %></a>
        <a href="#lokasi"><%- t('nav.loc') %></a><a href="#faq">FAQ</a>
        <a href="<%= base %>/survey"><%- t('survey.footer') %></a>
      </nav>
      <div class="foot__social">
        <a href="<%= contact.instagramUrl %>" target="_blank" rel="noopener" aria-label="Instagram"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1" class="fill"/></svg></a>
        <a href="https://wa.me/<%= contact.whatsapp %>" target="_blank" rel="noopener" aria-label="WhatsApp"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M21 12a9 9 0 0 1-13.5 7.8L3 21l1.2-4.4A9 9 0 1 1 21 12z"/></svg></a>
        <a href="mailto:<%= contact.email %>" aria-label="Email"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="3"/><path d="M4 7l8 6 8-6"/></svg></a>
      </div>
    </div>
    <div class="foot__bottom">
      <span>© <%= year %> Kalma Raja Ampat · <%- t('foot.reef') %></span>
      <span class="credit"><span><%- t('foot.credit') %></span> <b>Team Dampier</b></span>
    </div>
  </div>
</footer>

<a href="https://wa.me/<%= contact.whatsapp %>" class="wa-float" target="_blank" rel="noopener" aria-label="WhatsApp">
