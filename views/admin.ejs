<!doctype html>
<html lang="id">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="robots" content="noindex, nofollow">
<title>Admin · Pertanyaan Pemesanan · Kalma</title>
<link rel="icon" href="/brand/assets/favicon-32.png" type="image/png">
<link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght,SOFT@9..144,300..700,100&family=Plus+Jakarta+Sans:wght@400;600&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/brand/tokens.css">
<link rel="stylesheet" href="/css/style.css">
</head>
<body class="admin">
<header class="admin__head">
  <div class="wrap admin__bar">
    <img src="/brand/assets/kalma-wordmark.png" alt="Kalma" width="96" height="46">
    <span>Pertanyaan pemesanan</span>
    <a class="link" href="/admin/inquiries.json">Unduh JSON</a>
  </div>
</header>
<main class="wrap admin__main">
  <h1><%= items.length %> pertanyaan</h1>
  <% if (!items.length) { %>
    <p class="lead">Belum ada pertanyaan masuk.</p>
  <% } else { %>
  <div class="admin__table">
    <table>
      <thead><tr><th>Masuk</th><th>Nama</th><th>Tanggal</th><th>Tamu</th><th>Kamar</th><th>Pesan</th><th></th></tr></thead>
      <tbody>
      <% items.forEach(function (it) {
           var room = rooms.find(function (r) { return r.id === it.room; });
           var reply = replyLink(it.contact, it.name); %>
        <tr>
          <td><%= new Date(it.createdAt).toLocaleString('id-ID', { dateStyle: 'medium', timeStyle: 'short' }) %><br><span class="badge badge--<%= it.lang === 'en' ? 'lagoon' : 'sand' %>"><%= (it.lang || 'id').toUpperCase() %></span></td>
          <td><b><%= it.name %></b><% if (it.contact) { %><br><small><%= it.contact %></small><% } %><% if (it.country) { %><br><small><%= it.country %></small><% } %></td>
          <td><%= it.checkin %> → <%= it.checkout %></td>
          <td><%= it.guests %></td>
          <td><%= room ? t(room.nameKey) : '—' %></td>
          <td class="admin__msg"><%= it.msg || '—' %></td>
          <td><% if (reply) { %><a class="btn btn--primary btn--sm" href="<%= reply %>" target="_blank" rel="noopener">Balas</a><% } else { %><small>Tanpa kontak; cek WhatsApp</small><% } %></td>
        </tr>
      <% }) %>
      </tbody>
    </table>
  </div>
  <% } %>
</main>
</body>
</html>
