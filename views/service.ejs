<!doctype html>
<html lang="<%= lang %>">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title><%= title %></title>
<meta name="description" content="<%= String(t(svc.key + '.d')).replace(/<[^>]+>/g, '') %>">
<link rel="canonical" href="<%= siteUrl %><%= path %>">
<link rel="alternate" hreflang="id" href="<%= siteUrl %><%= alt.id %>">
<link rel="alternate" hreflang="en" href="<%= siteUrl %><%= alt.en %>">
<meta name="theme-color" content="#FFFFFF">
<meta property="og:title" content="<%= title %>">
<meta property="og:url" content="<%= siteUrl %><%= path %>">
<meta property="og:image" content="<%= siteUrl %>/brand/assets/kalma-logo-original.png">
<link rel="icon" href="/brand/assets/favicon.ico" sizes="any">
<link rel="icon" href="/brand/assets/favicon-32.png" type="image/png" sizes="32x32">
<link rel="preload" href="/fonts/jakarta-latin.woff2" as="font" type="font/woff2" crossorigin>
<link rel="preload" href="/fonts/fraunces-latin.woff2" as="font" type="font/woff2" crossorigin>
<link rel="stylesheet" href="/brand/tokens.css?v=<%= v %>">
<link rel="stylesheet" href="/css/style.css?v=<%= v %>">
<link rel="stylesheet" href="/css/home.css?v=<%= v %>">
<link rel="stylesheet" href="/css/pages.css?v=<%= v %>">
</head>
<body class="home page">
<a class="skip" href="#main"><%- t('skip') %></a>
<%- include('partials/site-nav', { current: 'services' }) %>
<%
  const sv = t('sv');
  const tick = '<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12.5l4.5 4.5L19 7.5"/></svg>';
  const IC = {
    clock: '<svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg>',
    sun: '<svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>',
    level: '<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 20V14M10 20V9M16 20V4M22 20H2"/></svg>',
    group: '<svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="9" cy="8" r="3.5"/><path d="M2.5 20c.8-3.6 3.3-5.5 6.5-5.5s5.7 1.9 6.5 5.5"/><path d="M16 4.6a3.5 3.5 0 0 1 0 6.8M18.5 14.8c1.6.8 2.6 2.5 3 5.2"/></svg>',
    bag: '<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 8h14l-1 12H6z"/><path d="M9 8V6a3 3 0 0 1 6 0v2"/></svg>',
    info: '<svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 11v6M12 7.5v.5"/></svg>',
  };
  const peopleText = (a) => a.maxPeople && a.maxPeople < 20 ? sv.people.replace('{min}', a.minPeople).replace('{max}', a.maxPeople) : sv.peopleMin.replace('{min}', a.minPeople);
  const bg = photoOf(svc.photo[0]) || photoOf(svc.photo[1]);
  const others = ['homestay', 'diving', 'trip'].filter((id) => id !== svc.id);
  const OTHER = { homestay: ['s1', 'svc-homestay', 'hero-2', 'ph-house'], diving: ['s2', 'svc-diving', 'hero-4', 'ph-reef'], trip: ['s3', 'svc-trips', 'hero-1', 'ph-karst'] };
%>
<main id="main">
  <section class="pg-hero">
    <div class="photo pg-hero__bg <%= svc.ph %>" style="<%= bg %>"></div>
    <div class="wrap pg-hero__in">
      <nav class="crumbs" aria-label="Breadcrumb"><a href="<%= home %>"><%= sv.crumbHome %></a><span aria-hidden="true">/</span><a href="<%= anchor('#kamar') %>"><%= sv.crumbSvc %></a><span aria-hidden="true">/</span><span aria-current="page"><%- t(svc.key + '.t') %></span></nav>
      <h1><%- t(svc.key + '.t') %></h1>
      <p class="pg-hero__lead"><%- t(svc.key + '.d') %></p>
      <% if (svc.category && list.length) { %><p class="pg-hero__count"><%= sv.count.replace('{n}', list.length) %></p><% } %>
    </div>
  </section>

<% if (svc.id === 'homestay') { %>
  <section class="sec">
    <div class="wrap">
      <div class="incl">
        <h2><%= sv.stayIncl %></h2>
        <ul><% [1, 2, 3, 4].forEach(function (i) { %><li><%- tick %><%= sv['incl' + i] %></li><% }) %></ul>
      </div>
      <div class="sec__head">
        <h2><%= sv.stayTitle %></h2>
        <p class="sub"><%= sv.stayLead %></p>
      </div>
      <div class="rooms-list">
        <% rooms.forEach(function (r) { %>
        <article class="room-card" id="<%= r.id %>">
          <div class="photo room-card__img <%= r.ph %>" style="<%= r.style %>"><span class="room-card__badge"><%= r.badge %></span></div>
          <div class="room-card__body">
            <h3><%= r.name %></h3>
            <p><%= r.desc %></p>
            <ul class="room-card__facts"><% r.facts.forEach(function (f) { %><li><%- tick %><%= f %></li><% }) %></ul>
          </div>
          <div class="room-card__side">
            <p class="room-card__price"><b><%= rupiah(r.price) %></b><small><%- t('r.per') %></small></p>
            <a class="btn btn--cta" href="<%= bookPath %>?room=<%= r.id %>"><%= sv.bookRoom %></a>
          </div>
        </article>
        <% }) %>
      </div>
      <p class="note"><%- t('rooms.note') %></p>
      <div class="know">
        <h2><%= sv.know %></h2>
        <div class="know__grid">
          <% [1, 2, 4, 5, 6].forEach(function (i) { %>
          <div class="know__item"><h3><%- t('q' + i + '.q') %></h3><p><%- t('q' + i + '.a') %></p></div>
          <% }) %>
        </div>
      </div>
    </div>
  </section>
<% } else { %>
  <section class="sec acts-sec">
    <div class="wrap">
      <% if (!list.length) { %>
      <p class="lead"><%= sv.emptyList %></p>
      <% } else { %>
      <nav class="acts-nav" aria-label="<%= sv.all %>">
        <% list.forEach(function (a) { %><a href="#<%= a.slug %>"><%= a.title %></a><% }) %>
      </nav>
      <div class="acts">
        <% list.forEach(function (a, i) { %>
        <article class="act" id="<%= a.slug %>">
          <div class="act__media">
            <div class="photo act__img <%= i % 2 ? 'ph-deep' : svc.ph %>" style="<%= a.photo ? '--img:url(' + a.photo + ')' : (i === 0 ? bg : '') %>"><span class="act__n"><%= String(i + 1).padStart(2, '0') %></span></div>
            <dl class="act__facts">
              <% if (a.duration) { %><div><dt><%- IC.clock %><%= sv.duration %></dt><dd><%= a.duration %></dd></div><% } %>
              <% if (a.startTime) { %><div><dt><%- IC.sun %><%= sv.start %></dt><dd><%= a.startTime %></dd></div><% } %>
              <% if (a.level) { %><div><dt><%- IC.level %><%= sv.level %></dt><dd><span class="lv lv--<%= a.level %>"></span><%= sv['lv_' + a.level] || a.level %></dd></div><% } %>
              <div><dt><%- IC.group %><%= sv.group %></dt><dd><%= peopleText(a) %></dd></div>
            </dl>
          </div>
          <div class="act__body">
            <h2><%= a.title %></h2>
            <p class="act__summary"><%= a.summary %></p>
            <div class="act__about">
              <h3><%= sv.about %></h3>
              <% a.body.forEach(function (p) { %><p><%= p %></p><% }) %>
            </div>
            <div class="act__cols">
              <% if (a.includes.length) { %><div><h3><%= sv.includes %></h3><ul class="ticks"><% a.includes.forEach(function (x) { %><li><%- tick %><%= x %></li><% }) %></ul></div><% } %>
              <% if (a.bring.length) { %><div><h3><%= sv.bring %></h3><ul class="dots-list"><% a.bring.forEach(function (x) { %><li><%= x %></li><% }) %></ul></div><% } %>
            </div>
            <% if (a.notes) { %><p class="act__note"><%- IC.info %><span><b><%= sv.notes %></b> <%= a.notes %></span></p><% } %>
            <div class="act__buy">
              <p class="act__price">
                <% if (a.free) { %><b><%= sv.free %></b>
                <% } else if (a.bookable) { %><b><%= rupiah(a.price) %></b><small><%= sv.perPerson %></small>
                <% } else { %><b class="act__ask"><%= sv.onRequest %></b><% } %>
              </p>
              <% if (!a.free) { %><a class="btn btn--cta" href="<%= bookPath %>?trip=<%= a.slug %>"><%= a.bookable ? sv.book : sv.bookAsk %></a><% } %>
            </div>
          </div>
        </article>
        <% }) %>
      </div>
      <% } %>
    </div>
  </section>
<% } %>

  <section class="sec sec--tint">
    <div class="wrap">
      <div class="cta-band">
        <div><h2><%= sv.ctaTitle %></h2><p><%= sv.ctaText %></p></div>
        <a class="btn btn--cta" href="<%= bookPath %>"><%- t('nav.book') %></a>
      </div>
      <h2 class="others__title"><%= sv.other %></h2>
      <div class="others">
        <% others.forEach(function (id) { const o = OTHER[id]; %>
        <a class="other" href="<%= servicePath(id) %>">
          <span class="photo other__img <%= o[3] %>" style="<%= photoOf(o[1]) || photoOf(o[2]) %>"></span>
          <span class="other__body"><b><%- t(o[0] + '.t') %></b><small><%- t(o[0] + '.more') %></small></span>
        </a>
        <% }) %>
      </div>
    </div>
  </section>
</main>
<%- include('partials/site-foot') %>
<script src="/js/site.js?v=<%= v %>" defer></script>
</body>
</html>
