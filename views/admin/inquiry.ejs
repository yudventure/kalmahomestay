<%- include('_top') %>
<p class="crumb"><a href="/admin/inquiries">← Semua permintaan</a></p>
<h1>Permintaan #<%= item.id %> <%- include('_status', { s: item.status }) %></h1>
<div class="grid2">
  <section class="panel">
    <h2>Detail menginap</h2>
    <dl class="dl">
      <dt>Check-in</dt><dd><%= fmtDate(item.checkin) %></dd>
      <dt>Check-out</dt><dd><%= fmtDate(item.checkout) %> (<%= nights(item.checkin, item.checkout) %> malam)</dd>
      <dt>Tamu</dt><dd><%= item.guests %></dd>
      <dt>Kamar</dt><dd><%= roomName(item.room) %></dd>
      <dt>Pesan</dt><dd class="pre"><%= item.message || '-' %></dd>
      <dt>Bahasa</dt><dd><%= item.lang === 'en' ? 'English' : 'Indonesia' %></dd>
      <dt>Masuk</dt><dd><%= fmtDateTime(item.created_at) %></dd>
    </dl>
    <% if (item.order_id) { %>
    <h2>Pembayaran online</h2>
    <dl class="dl">
      <dt>Status</dt><dd><%- include('_pay', { p: item.payment_status }) %></dd>
      <dt>Order ID</dt><dd><code><%= item.order_id %></code></dd>
      <dt>Dibayar online</dt><dd>Rp <%= Number(item.amount || 0).toLocaleString('id-ID') %><% if (item.total && Number(item.total) !== Number(item.amount)) { %> dari total Rp <%= Number(item.total).toLocaleString('id-ID') %><% } %></dd>
      <% if (item.payment_type) { %><dt>Metode</dt><dd><%= item.payment_type %></dd><% } %>
      <% if (item.paid_at) { %><dt>Lunas pada</dt><dd><%= fmtDateTime(item.paid_at) %></dd><% } %>
    </dl>
    <% } %>
  </section>
  <section class="panel">
    <h2>Customer</h2>
    <dl class="dl">
      <dt>Nama</dt><dd><a href="/admin/customers/<%= item.customer_id %>"><b><%= item.name %></b></a></dd>
      <dt>WhatsApp/HP</dt><dd><%= phoneDisplay(item.phone) || '-' %></dd>
      <dt>Email</dt><dd><%= item.email || '-' %></dd>
      <% if (item.other_contact) { %><dt>Kontak lain</dt><dd><%= item.other_contact %></dd><% } %>
      <dt>Asal</dt><dd><%= item.country || '-' %></dd>
    </dl>
    <% var r = reply(item); if (r) { %><a class="btn btn--cta btn--sm" href="<%= r.href %>" target="_blank" rel="noopener"><%= r.label %></a><% } else { %><p class="muted">Tidak ada nomor/email. Cek pesan WhatsApp masuk dari customer ini.</p><% } %>
  </section>
</div>
<section class="panel">
  <h2>Tindak lanjut</h2>
  <form method="post" action="/admin/inquiries/<%= item.id %>" class="stack">
    <div class="field"><label for="status">Status</label>
      <select id="status" name="status"><% STATUSES.forEach(function (s) { %><option value="<%= s.id %>"<%= s.id === item.status ? ' selected' : '' %>><%= s.label %></option><% }) %></select></div>
    <div class="field"><label for="admin_note">Catatan internal</label>
      <textarea id="admin_note" name="admin_note" rows="4" maxlength="2000" placeholder="Mis. sudah transfer DP, jemput di Waisai jam 14.00"><%= item.admin_note || '' %></textarea></div>
    <button class="btn btn--primary" type="submit">Simpan</button>
  </form>
</section>
<% if (can('finance')) { var paidSum = payments.reduce(function (s, p) { return s + p.amount; }, 0); %>
<section class="panel">
  <div class="panel__head"><h2>Pembayaran</h2><a class="link" href="/admin/finance">Keuangan →</a></div>
  <% if (flash === 'paid') { %><p class="alert alert--ok" role="status">Pembayaran dicatat di Keuangan.</p><% } %>
  <% if (flashErr === 'amount') { %><p class="alert alert--err" role="alert">Isi jumlah pembayaran.</p><% } %>
  <% if (payments.length) { %><ul class="list"><% payments.forEach(function (p) { %><li><a><b><%= rupiah(p.amount) %></b><span><%= fmtDate(p.date) %> · <%= p.method || '' %></span><small><%= p.description %></small></a></li><% }) %></ul>
  <p class="muted small">Total diterima: <b><%= rupiah(paidSum) %></b><% if (item.total) { %> dari <%= rupiah(item.total) %><% } %></p><% } else { %><p class="muted">Belum ada pembayaran tercatat.</p><% } %>
  <form method="post" action="/admin/finance/booking/<%= item.id %>" class="inline admin" style="margin-top: var(--space-3)">
    <input name="amount" inputmode="numeric" placeholder="Jumlah (Rp)" required aria-label="Jumlah">
    <select name="method" aria-label="Metode"><option>transfer</option><option>cash</option><option>qris</option><option>kartu</option></select>
    <input name="date" type="date" aria-label="Tanggal">
    <button class="btn btn--primary btn--sm" type="submit">Catat pembayaran</button>
  </form>
</section>
<% } %>
<form method="post" action="/admin/inquiries/<%= item.id %>/delete" class="danger" onsubmit="return confirm('Hapus permintaan ini? Tidak bisa dibatalkan.')">
  <button class="btn btn--danger btn--sm" type="submit">Hapus permintaan ini</button>
</form>
<%- include('_bottom') %>
