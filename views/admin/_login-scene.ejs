<%# Login background: Raja Ampat at golden hour, the overwater homestay, a palm beach and the hermit crab. Decorative only. %>
<svg class="login__scene" viewBox="0 0 1600 1000" preserveAspectRatio="xMidYMid slice" aria-hidden="true" xmlns="http://www.w3.org/2000/svg">
  <defs>
    <linearGradient id="ls-sky" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#18344D"/><stop offset=".45" stop-color="#2F5F7E"/><stop offset=".72" stop-color="#6E9DB3"/><stop offset=".86" stop-color="#E9C99A"/><stop offset="1" stop-color="#F2D7A6"/>
    </linearGradient>
    <linearGradient id="ls-sea" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#4B8AA5"/><stop offset=".35" stop-color="#2E6886"/><stop offset="1" stop-color="#173149"/>
    </linearGradient>
    <radialGradient id="ls-glow" cx=".5" cy=".5" r=".5"><stop offset="0" stop-color="#FFE7B8" stop-opacity=".9"/><stop offset="1" stop-color="#FFE7B8" stop-opacity="0"/></radialGradient>
    <linearGradient id="ls-shine" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#FFE3AE" stop-opacity=".8"/><stop offset="1" stop-color="#FFE3AE" stop-opacity="0"/></linearGradient>
    <linearGradient id="ls-sand" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#EDE0B5"/><stop offset="1" stop-color="#D8C48E"/></linearGradient>
  </defs>

  <rect width="1600" height="1000" fill="url(#ls-sky)"/>
  <!-- stars in the deep blue -->
  <g class="ls-stars" fill="#fff"><circle cx="160" cy="90" r="1.6"/><circle cx="320" cy="150" r="1.2"/><circle cx="520" cy="70" r="1.4"/><circle cx="760" cy="120" r="1.1"/><circle cx="980" cy="60" r="1.5"/><circle cx="1220" cy="110" r="1.2"/><circle cx="1420" cy="70" r="1.6"/><circle cx="1500" cy="180" r="1.1"/><circle cx="90" cy="220" r="1.1"/></g>
  <!-- sun at the horizon -->
  <circle class="ls-glow" cx="1060" cy="600" r="260" fill="url(#ls-glow)"/>
  <circle cx="1060" cy="600" r="70" fill="#FFE2A8"/>
  <!-- clouds -->
  <g class="ls-cloud" fill="#FBE9CF" opacity=".8"><ellipse cx="300" cy="420" rx="120" ry="16"/><ellipse cx="360" cy="408" rx="70" ry="14"/><ellipse cx="1300" cy="380" rx="140" ry="14"/><ellipse cx="1240" cy="370" rx="60" ry="12"/></g>
  <!-- birds -->
  <g class="ls-birds" fill="none" stroke="#18344D" stroke-width="3" stroke-linecap="round"><path d="M600 300q12-12 24 0q12-12 24 0"/><path d="M660 330q9-9 18 0q9-9 18 0"/><path d="M560 345q8-8 16 0q8-8 16 0"/></g>

  <!-- karst islands -->
  <path d="M0 610c40-80 90-120 140-118 46 2 70 60 96 118z" fill="#24433A"/>
  <path d="M170 610c30-50 62-74 92-74 26 0 46 34 60 74z" fill="#2E5446"/>
  <path d="M560 612c24-70 60-110 100-112 40 2 66 50 84 112z" fill="#2E5446" opacity=".9"/>
  <path d="M700 612c14-36 34-54 56-54 18 0 32 22 42 54z" fill="#3F6B4E" opacity=".8"/>
  <path d="M1300 610c30-90 76-140 126-142 56 2 90 66 118 142z" fill="#24433A"/>
  <path d="M1480 610c20-46 46-70 72-70 22 0 38 26 48 70z" fill="#2E5446"/>

  <!-- sea -->
  <rect y="600" width="1600" height="400" fill="url(#ls-sea)"/>
  <rect x="1010" y="600" width="100" height="320" fill="url(#ls-shine)" class="ls-shine"/>
  <g class="ls-waves" fill="none" stroke="#9CC6D6" stroke-width="2.5" stroke-linecap="round" opacity=".55">
    <path d="M-100 650q40-10 80 0t80 0 80 0 80 0 80 0 80 0 80 0 80 0 80 0 80 0 80 0 80 0 80 0 80 0 80 0 80 0 80 0 80 0 80 0 80 0 80 0 80 0"/>
    <path d="M-60 720q50-12 100 0t100 0 100 0 100 0 100 0 100 0 100 0 100 0 100 0 100 0 100 0 100 0 100 0 100 0 100 0 100 0 100 0 100 0"/>
    <path d="M-120 800q60-14 120 0t120 0 120 0 120 0 120 0 120 0 120 0 120 0 120 0 120 0 120 0 120 0 120 0 120 0 120 0 120 0"/>
  </g>

  <!-- the overwater homestay on stilts, lights on -->
  <g class="ls-home">
    <path d="M880 690h720v14H880z" fill="#7A5634"/>
    <g stroke="#5A3F26" stroke-width="7"><path d="M900 704v90M980 704v96M1060 704v90M1140 704v96M1220 704v90M1300 704v96M1380 704v90M1460 704v96M1540 704v90"/></g>
    
    <!-- hut 1 -->
    <rect x="930" y="616" width="130" height="76" fill="#B98957"/>
    <path d="M908 624l87-62 87 62z" fill="#D9B07E"/><path d="M908 624l87-62 87 62" fill="none" stroke="#8E6438" stroke-width="5" stroke-linejoin="round"/>
    <rect class="ls-light" x="952" y="638" width="30" height="28" rx="3" fill="#FFD27A"/><rect x="1004" y="640" width="34" height="52" rx="3" fill="#5A3F26"/>
    <!-- hut 2 -->
    <rect x="1130" y="604" width="150" height="88" fill="#B98957"/>
    <path d="M1104 614l101-72 101 72z" fill="#D9B07E"/><path d="M1104 614l101-72 101 72" fill="none" stroke="#8E6438" stroke-width="5" stroke-linejoin="round"/>
    <rect class="ls-light ls-light--b" x="1150" y="628" width="34" height="30" rx="3" fill="#FFD27A"/><rect class="ls-light" x="1228" y="628" width="34" height="30" rx="3" fill="#FFD27A"/>
    <!-- hut 3 -->
    <rect x="1360" y="618" width="124" height="74" fill="#B98957"/>
    <path d="M1338 626l84-60 84 60z" fill="#D9B07E"/><path d="M1338 626l84-60 84 60" fill="none" stroke="#8E6438" stroke-width="5" stroke-linejoin="round"/>
    <rect class="ls-light ls-light--c" x="1380" y="640" width="30" height="28" rx="3" fill="#FFD27A"/>
  </g>

  <!-- a longboat resting on the water -->
  <g class="ls-boat"><path d="M640 760h190l-24 22H664z" fill="#E07A5F"/><path d="M648 760h176" stroke="#F2D7A6" stroke-width="4"/></g>

  <!-- beach in front -->
  <path d="M0 860c180-60 420-70 640-40s300 60 460 40 360-60 500-40v180H0z" fill="url(#ls-sand)"/>
  <g fill="#C9B07A"><circle cx="120" cy="930" r="3"/><circle cx="260" cy="900" r="2.5"/><circle cx="420" cy="950" r="3"/><circle cx="700" cy="920" r="2.5"/><circle cx="980" cy="960" r="3"/><circle cx="1240" cy="930" r="2.5"/><circle cx="1500" cy="950" r="3"/></g>
  <!-- palms -->
  <g class="ls-palm" style="transform-origin: 170px 900px">
    <path d="M170 900c-6-110 6-220 46-320" fill="none" stroke="#6B4A2C" stroke-width="16" stroke-linecap="round"/>
    <g fill="#2E5446"><path d="M216 584c-60-34-130-28-176 10 60-14 120-6 176-10z"/><path d="M216 584c-20-60-80-96-140-96 54 20 100 58 140 96z"/><path d="M216 584c40-50 110-62 170-36-60 4-116 16-170 36z"/><path d="M216 584c60-10 120 20 150 76-50-36-100-56-150-76z"/><path d="M216 584c-50 10-100 50-116 110 30-50 70-86 116-110z"/></g>
    <circle cx="210" cy="598" r="10" fill="#6B4A2C"/><circle cx="226" cy="600" r="9" fill="#6B4A2C"/>
  </g>
  <g class="ls-palm ls-palm--b" style="transform-origin: 300px 910px">
    <path d="M300 910c10-80 0-160-30-230" fill="none" stroke="#6B4A2C" stroke-width="12" stroke-linecap="round"/>
    <g fill="#3F6B4E"><path d="M270 680c-50-24-100-14-130 20 44-12 90-10 130-20z"/><path d="M270 680c30-44 84-52 128-30-46 2-88 14-128 30z"/><path d="M270 680c40 4 80 34 96 76-34-30-66-52-96-76z"/><path d="M270 680c-30 16-60 50-64 92 18-38 40-66 64-92z"/></g>
  </g>
  <!-- kayak and the hermit crab -->
  <g transform="translate(1180 900) rotate(-6)"><path d="M0 0c60-18 180-18 240 0-60 18-180 18-240 0z" fill="#4B8AA5"/><path d="M90 -2h60" stroke="#18344D" stroke-width="5" stroke-linecap="round"/></g>
  <g class="ls-crab" style="transform-origin: 560px 930px">
    <path d="M534 932c0-22 18-38 38-38s36 16 36 36c0 8-5 10-12 10h-50c-8 0-12-3-12-8z" fill="#EDE0B5" stroke="#18344D" stroke-width="4"/>
    <path d="M572 908a13 13 0 1 1-13 13c0-5 4-9 9-9a6 6 0 0 1 6 6" fill="none" stroke="#18344D" stroke-width="3.5" stroke-linecap="round"/>
    <path d="M522 932c-3-10 5-18 15-15" fill="#E07A5F" stroke="#18344D" stroke-width="3.5"/>
    <circle cx="524" cy="912" r="3.5" fill="#18344D"/><circle cx="534" cy="910" r="3.5" fill="#18344D"/>
    <path d="M528 940l-8 10M538 940l-3 12M548 940l3 12" stroke="#E07A5F" stroke-width="4" stroke-linecap="round"/>
  </g>
  <!-- shells -->
  <path d="M820 950c0-12 10-22 22-22s22 10 22 22z" fill="#F3D3C7" stroke="#E07A5F" stroke-width="2.5"/>
  <path d="M1460 900l6 12 13 1-10 9 3 13-12-7-12 7 3-13-10-9 13-1z" fill="#E07A5F" opacity=".9"/>
</svg>
