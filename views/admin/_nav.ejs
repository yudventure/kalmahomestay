<%
// Admin menu. Each group shows only for roles that may open it (see src/staff.js).
var NAV = [
  { items: [{ href: '/admin', label: 'Ringkasan', match: function (p) { return p === '/'; } }] },
  { title: 'Reservasi', area: 'reservations', items: [
    { href: '/admin/inquiries', label: 'Permintaan & booking' },
    { href: '/admin/calendar', label: 'Kalender' },
    { href: '/admin/channels', label: 'Channel OTA & agen' },
    { href: '/admin/customers', label: 'Customer' } ] },
  { title: 'Website', area: 'website', items: [
    { href: '/admin/website/content', label: 'Teks website' },
    { href: '/admin/website/rooms', label: 'Kamar & harga' },
    { href: '/admin/website/contact', label: 'Kontak & sosial media' },
    { href: '/admin/website/partners', label: 'Partner' },
    { href: '/admin/instagram', label: 'Komentar Instagram' },
    { href: '/admin/survey', label: 'Survei tamu' } ] },
  { title: 'SDM', items: [
    { href: '/admin/hr/employees', label: 'Karyawan', area: 'hr' },
    { href: '/admin/hr/attendance', label: 'Absensi', area: 'hr' },
    { href: '/admin/hr/leave', label: 'Cuti & izin', area: 'hr' },
    { href: '/admin/payroll', label: 'Penggajian', area: 'payroll' } ] },
  { title: 'Keuangan', area: 'finance', items: [
    { href: '/admin/finance', label: 'Transaksi' },
    { href: '/admin/finance/report', label: 'Laporan laba rugi' } ] },
  { title: 'Sistem', area: 'users', items: [{ href: '/admin/users', label: 'Pengguna & peran' }] },
];
var path = '/admin' + (current === '/' ? '' : current);
%>
<nav class="side__nav" aria-label="Menu admin">
<% NAV.forEach(function (g) { if (g.area && !can(g.area)) return; var items = g.items.filter(function (i) { return !i.soon && (!i.area || can(i.area)); }); if (!items.length) return; %>
  <% if (g.title) { %><p class="side__group"><%= g.title %></p><% } %>
  <% items.forEach(function (i) { var on = i.match ? i.match(current) : path === i.href || path.indexOf(i.href + '/') === 0; %>
  <a href="<%= i.href %>"<%- on ? ' aria-current="page"' : '' %>><%= i.label %></a>
  <% }) %>
<% }) %>
</nav>
