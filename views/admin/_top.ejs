<!doctype html>
<html lang="id">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="robots" content="noindex, nofollow">
<title><%= title %> · Admin Kalma</title>
<link rel="icon" href="/brand/assets/favicon-32.png" type="image/png">
<link rel="stylesheet" href="/brand/tokens.css?v=<%= v %>">
<link rel="stylesheet" href="/css/style.css?v=<%= v %>">
<link rel="stylesheet" href="/css/admin.css?v=<%= v %>">
</head>
<body class="admin">
<header class="admin__head">
  <div class="wrap admin__bar">
    <a href="/admin" class="admin__logo"><img src="/brand/assets/kalma-wordmark.png" alt="Kalma" width="96" height="46"><span>Admin</span></a>
    <nav class="admin__nav" aria-label="Admin">
      <a href="/admin"<%- current === '/' ? ' aria-current="page"' : '' %>>Ringkasan</a>
      <a href="/admin/inquiries"<%- current.startsWith('/inquiries') ? ' aria-current="page"' : '' %>>Permintaan</a>
      <a href="/admin/customers"<%- current.startsWith('/customers') ? ' aria-current="page"' : '' %>>Customer</a>
      <a href="/admin/survey"<%- current.startsWith('/survey') ? ' aria-current="page"' : '' %>>Survei</a>
      <a href="/admin/instagram"<%- current.startsWith('/instagram') ? ' aria-current="page"' : '' %>>Instagram</a>
    </nav>
    <a class="admin__site" href="/" target="_blank" rel="noopener">Lihat website ↗</a>
  </div>
</header>
<main class="wrap admin__main">
<% if (storage === 'file') { %><p class="alert alert--warn">Mode pengembangan: data disimpan di file JSON lokal. Di server produksi isi pengaturan database MySQL (lihat DEPLOY.md).</p><% } %>
<% var flashText = { 'saved': 'Perubahan tersimpan.', 'customer-deleted': 'Data customer dan semua permintaannya sudah dihapus.', 'inquiry-deleted': 'Permintaan sudah dihapus.', 'survey-deleted': 'Jawaban survei sudah dihapus.', 'ig-synced': 'Komentar Instagram sudah diperbarui.' }[flash]; %>
<% if (flashText) { %><p class="alert alert--ok" role="status"><%= flashText %></p><% } %>
