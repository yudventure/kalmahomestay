<!doctype html>
<html lang="id">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="robots" content="noindex, nofollow">
<title><%= title %> · Admin Kalma</title>
<link rel="icon" href="/brand/assets/favicon-32.png" type="image/png">
<link rel="stylesheet" href="/brand/tokens.css?v=<%= v %>">
<link rel="stylesheet" href="/css/style.css?v=<%= v %>">
<link rel="stylesheet" href="/css/admin.css?v=<%= v %>">
</head>
<body class="admin">
<div class="shell">
<aside class="side" id="side">
  <div class="side__top">
    <a href="/admin" class="admin__logo"><img src="/brand/assets/kalma-wordmark.png" alt="Kalma" width="96" height="46"><span>Admin</span></a>
    <button type="button" class="side__toggle" aria-controls="side-body" aria-expanded="false" onclick="var b=document.getElementById('side-body');var o=b.classList.toggle('is-open');this.setAttribute('aria-expanded',o)">Menu</button>
  </div>
  <div class="side__body" id="side-body">
    <%- include('_nav') %>
    <div class="side__me">
      <b><%= me.name %></b><span><%= roleLabel(me.role) %></span>
      <div class="side__links"><a href="/admin/account">Akun saya</a> · <a href="/" target="_blank" rel="noopener">Lihat website ↗</a></div>
      <form method="post" action="/admin/logout"><button class="btn btn--ghost btn--sm" type="submit">Keluar</button></form>
    </div>
  </div>
</aside>
<main class="admin__main">
<% if (storage === 'file') { %><p class="alert alert--warn">Mode pengembangan: data disimpan di file JSON lokal. Di server produksi isi pengaturan database MySQL (lihat DEPLOY.md).</p><% } %>
<% var flashText = { 'saved': 'Perubahan tersimpan.', 'deleted': 'Data sudah dihapus.', 'customer-deleted': 'Data customer dan semua permintaannya sudah dihapus.', 'inquiry-deleted': 'Permintaan sudah dihapus.', 'survey-deleted': 'Jawaban survei sudah dihapus.', 'ig-synced': 'Komentar Instagram sudah diperbarui.', 'ig-added': 'Komentar ditambahkan dan langsung tampil di website.', 'ig-deleted': 'Komentar dihapus.', 'synced': 'Kalender sudah disinkronkan.' }[flash]; %>
<% if (flashText) { %><p class="alert alert--ok" role="status"><%= flashText %></p><% } %>
