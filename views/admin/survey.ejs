<%- include('_top') %>
<% var sl = locals.adminLang === 'en' ? 'en' : 'id'; %>
<h1>Survei tamu <small class="muted">(<%= total %> jawaban)</small></h1>
<div class="btns" style="margin-bottom: var(--space-5)"><a class="btn btn--ghost btn--sm" href="/admin/export/survey.csv">Unduh semua jawaban (.csv)</a></div>

<% if (!total) { %>
  <section class="panel"><p class="muted">Belum ada jawaban. Bagikan link survei ke tamu, grup Facebook, atau Instagram.</p></section>
<% } else { var n = 0; sections.forEach(function (sec) { %>
  <h2 class="sv-sec"><span><%= sec.id %></span> <%= sec.title[sl] %></h2>
  <% sec.questions.forEach(function (q) { n += 1; if (q.contact) return; var s = summary[q.id]; %>
  <section class="panel">
    <div class="panel__head"><h3 class="sv-q"><%= n %>. <%= q.text[sl] %></h3><small class="muted"><%= s.answered %> / <%= total %> menjawab</small></div>
    <% if (q.options) {
         var rows = q.options.map(function (op) { return { label: op.label[sl], c: s.counts[op.id] }; }).sort(function (a, b) { return b.c - a.c; }); %>
      <ul class="bars">
      <% rows.forEach(function (row) { var pct = s.answered ? Math.round(row.c / s.answered * 100) : 0; %>
        <li><span class="bars__label"><%= row.label %></span><span class="bars__track"><span class="bars__fill" style="width: <%= pct %>%"></span></span><span class="bars__val"><%= row.c %> · <%= pct %>%</span></li>
      <% }) %>
      </ul>
      <% if (q.type === 'multi') { %><p class="muted small">Persentase dari yang menjawab. Satu orang bisa memilih lebih dari satu.</p><% } %>
    <% } else if (!s.texts.length) { %>
      <p class="muted">Belum ada jawaban.</p>
    <% } else { %>
      <ul class="quotes">
      <% s.texts.slice(0, 50).forEach(function (a) { %>
        <li><q><%= a.text %></q> <a class="muted small" href="/admin/survey/<%= a.id %>">#<%= a.id %> · <%= a.lang.toUpperCase() %></a></li>
      <% }) %>
      </ul>
      <% if (s.texts.length > 50) { %><p class="muted small">Menampilkan 50 terbaru dari <%= s.texts.length %>. Lihat semua di CSV.</p><% } %>
    <% } %>
  </section>
  <% }) %>
<% }) %>

  <h2 class="sv-sec">Semua jawaban</h2>
  <div class="table">
  <table>
    <thead><tr><th>#</th><th>Masuk</th><th>Bahasa</th><th>Pernah ke Raja Ampat?</th><th>Paling bikin repot</th><th>Kontak</th></tr></thead>
    <tbody>
    <% list.items.forEach(function (r) { var q1 = sections[0].questions[0].options.find(function (o) { return o.id === r.answers.q1; }); %>
      <tr>
        <td><a href="/admin/survey/<%= r.id %>">#<%= r.id %></a></td>
        <td><%= fmtDateTime(r.created_at) %></td>
        <td><%= r.lang.toUpperCase() %></td>
        <td><%= q1 ? q1.label[sl] : '-' %></td>
        <td class="admin__msg"><%= (r.answers.q8 || '').slice(0, 140) %><%= (r.answers.q8 || '').length > 140 ? '…' : '' %></td>
        <td><%= r.contact || '-' %></td>
      </tr>
    <% }) %>
    </tbody>
  </table>
  </div>
  <%- include('_pager', { result: list, params: {} }) %>
<% } %>
<%- include('_bottom') %>
