<%- include('_top') %>
<p class="crumb"><a href="/admin/survey">← Rekap survei</a></p>
<h1>Jawaban survei #<%= r.id %></h1>
<p class="muted"><%= fmtDateTime(r.created_at) %> · <%= r.lang === 'en' ? 'English' : 'Indonesia' %><% if (r.contact) { %> · Kontak: <b><%= r.contact %></b><% } %></p>
<section class="panel">
  <dl class="dl dl--wide">
  <% var n = 0; sections.forEach(function (sec) { sec.questions.forEach(function (q) { n += 1; if (q.contact) return;
       var v = r.answers[q.id]; var shown;
       if (v == null) shown = '—';
       else if (q.options) shown = (Array.isArray(v) ? v : [v]).map(function (id) { var o = q.options.find(function (x) { return x.id === id; }); return o ? o.label.id : id; }).join(', ');
       else shown = v; %>
    <dt><%= n %>. <%= q.text.id %></dt><dd class="pre"><%= shown %></dd>
  <% }) }) %>
  </dl>
</section>
<form method="post" action="/admin/survey/<%= r.id %>/delete" class="danger" onsubmit="return confirm('Hapus jawaban survei ini?')">
  <button class="btn btn--danger btn--sm" type="submit">Hapus jawaban ini</button>
</form>
<%- include('_bottom') %>
