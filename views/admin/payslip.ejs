<!doctype html>
<html lang="id"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><meta name="robots" content="noindex">
<title><%= title %> · <%= e.name %></title>
<link rel="stylesheet" href="/brand/tokens.css?v=<%= v %>"><link rel="stylesheet" href="/css/style.css?v=<%= v %>"><link rel="stylesheet" href="/css/admin.css?v=<%= v %>">
</head><body class="slip">
<main class="slip__page">
  <header class="slip__head"><img src="/brand/assets/kalma-wordmark.png" alt="Kalma" height="40"><div><b>Kalma Raja Ampat</b><br><small>Slip gaji · periode <%= r.period %></small></div></header>
  <table class="slip__table">
    <tr><th>Nama</th><td><%= e.name %></td></tr>
    <tr><th>Jabatan</th><td><%= e.position || '—' %><%= e.department ? ' · ' + e.department : '' %></td></tr>
    <tr><th>Gaji pokok</th><td class="num"><%= rupiah(r.base) %></td></tr>
    <tr><th>Tunjangan</th><td class="num"><%= rupiah(r.allowance) %></td></tr>
    <tr><th>Bonus</th><td class="num"><%= rupiah(r.bonus) %></td></tr>
    <tr><th>Potongan</th><td class="num">− <%= rupiah(r.deduction) %></td></tr>
    <tr class="slip__total"><th>Diterima</th><td class="num"><%= rupiah(r.net) %></td></tr>
  </table>
  <% if (r.note) { %><p><small><%= r.note %></small></p><% } %>
  <p><small><%= r.status === 'paid' ? 'Dibayar ' + fmtDateTime(r.paid_at) : 'Belum dibayar (draf)' %></small></p>
  <button onclick="window.print()" class="btn btn--primary btn--sm slip__print">Cetak / simpan PDF</button>
</main>
</body></html>
