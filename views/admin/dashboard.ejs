<%- include('_top') %>
<section class="hello">
  <p class="eyebrow-a"><%= roleLabel(me.role) %> · Dashboard Kalma</p>
  <div class="hello__row">
    <div>
      <h1><%= greeting %>, <%= firstName %>.</h1>
      <p><% if (alerts.length) { %>Hal yang perlu ditindaklanjuti hari ini: <%= alerts.length %>.<% } else { %>Semua beres. Tidak ada yang menunggu tindak lanjut saat ini.<% } %></p>
    </div>
    <div class="hello__clock"><b id="clock">--.--.--</b><small id="clock-date"><%= fmtDate(today) %> · WIT</small></div>
  </div>
</section>

<% if (can('reservations')) { %>
<div class="cards">
  <a class="card-stat" href="/admin/inquiries?status=new"><span>Permintaan baru</span><b><%= stats.counts.new %></b><em class="<%= stats.counts.new ? 'warn' : 'good' %>"><%= stats.counts.new ? 'Menunggu balasan' : 'Semua sudah dibalas' %></em></a>
  <a class="card-stat" href="/admin/calendar"><span>Check-in hari ini</span><b><%= arrivals.length %></b><em><%= departures.length %> check-out</em></a>
  <a class="card-stat" href="/admin/calendar"><span>Kamar terisi malam ini</span><b><%= inHouse.length %></b><em>dari kalender</em></a>
  <a class="card-stat" href="/admin/finance/report"><span>Okupansi bulan ini</span><b><%= occupancy %>%</b><em>malam terjual dibanding kapasitas</em></a>
</div>
<% } %>
<% if (can('finance') || can('hr')) { %>
<div class="cards">
  <% if (can('finance')) { %>
  <a class="card-stat" href="/admin/finance"><span>Pemasukan bulan ini</span><b class="money"><%= rupiah(income) %></b><em>pengeluaran <%= rupiah(expense) %></em></a>
  <a class="card-stat" href="/admin/finance/report"><span>Laba bulan ini</span><b class="money"><%= rupiah(income - expense) %></b><em class="<%= income - expense >= 0 ? 'good' : 'warn' %>"><%= income - expense >= 0 ? 'Untung' : 'Rugi' %></em></a>
  <% } %>
  <% if (can('hr')) { %>
  <a class="card-stat" href="/admin/hr/attendance"><span>Karyawan hadir hari ini</span><b><%= attendanceFilled ? presentToday + ' / ' + staffCount : '-' %></b><em class="<%= attendanceFilled ? 'good' : 'warn' %>"><%= attendanceFilled ? 'Absensi sudah diisi' : 'Absensi belum diisi' %></em></a>
  <a class="card-stat" href="/admin/hr/leave?status=pending"><span>Cuti menunggu</span><b><%= pendingLeave %></b><em><%= pendingLeave ? 'Perlu persetujuan' : 'Tidak ada' %></em></a>
  <% } %>
</div>
<% } %>

<% if (can('content')) { %>
<div class="cards">
  <a class="card-stat" href="/admin/content"><span>Konten 7 hari ke depan</span><b><%= contentWeek.length %></b><em><%= contentWeek.filter(function (p) { return p.status === 'siap' || p.status === 'tayang'; }).length %> sudah siap</em></a>
  <a class="card-stat" href="/admin/content/board"><span>Bank ide</span><b><%= contentIdeas %></b><em>ide yang belum dikerjakan</em></a>
  <% contentWeek.slice(0, 2).forEach(function (p) { %><a class="card-stat" href="/admin/content/<%= p.id %>"><span><%= fmtDate(p.publish_date) %><%= p.publish_time ? ' · ' + p.publish_time : '' %></span><b style="font-size:1.05rem;line-height:1.3"><%= p.title %></b><em><%= p.status === 'tayang' ? 'Sudah tayang' : 'Dijadwalkan' %></em></a><% }) %>
</div>
<% } %>

<section class="panel panel--attn<%= alerts.length ? ' is-alert' : '' %>">
  <div>
    <p class="eyebrow-a">Perlu perhatian</p>
    <% if (alerts.length) { %>
      <h2><%= alerts[0].label %></h2>
      <p><%= alerts.slice(1).map(function (a) { return a.label; }).join(', ') || alerts[0].sub %></p>
    <% } else { %>
      <h2>Tidak ada yang tertunda</h2>
      <p>Permintaan baru, check-in hari ini, cuti, dan sinkron OTA yang bermasalah akan muncul di sini.</p>
    <% } %>
  </div>
  <% if (alerts.length) { %><a class="pill-btn" href="<%= alerts[0].href %>">Buka sekarang →</a><% } %>
</section>

<% if (can('reservations')) { %>
<div class="grid3">
  <section class="panel action-card">
    <p class="eyebrow-a">Hari ini</p>
    <h2><%= arrivals.length + departures.length %> pergerakan tamu</h2>
    <% if (!arrivals.length && !departures.length) { %><p>Tidak ada check-in atau check-out hari ini.</p><% } else { %>
    <ul class="list" style="margin-bottom:16px">
      <% arrivals.forEach(function (it) { %><li><a<%- it.href ? ' href="' + it.href + '"' : '' %>><b>Check-in · <%= it.label %></b><span><%= roomName(it.room) %> · <%= nights(it.start, it.end) %> malam<%= it.channel ? ' · ' + it.channel : '' %></span></a></li><% }) %>
      <% departures.forEach(function (it) { %><li><a<%- it.href ? ' href="' + it.href + '"' : '' %>><b>Check-out · <%= it.label %></b><span><%= roomName(it.room) %></span></a></li><% }) %>
    </ul><% } %>
    <a class="pill-btn" href="/admin/calendar">Buka kalender →</a>
  </section>
  <section class="panel action-card">
    <p class="eyebrow-a">Permintaan masuk</p>
    <h2><%= newTotal %> menunggu balasan</h2>
    <% if (!recent.length) { %><p>Belum ada permintaan baru dari website.</p><% } else { %>
    <ul class="list" style="margin-bottom:16px">
      <% recent.slice(0, 3).forEach(function (it) { %><li><a href="/admin/inquiries/<%= it.id %>"><b><%= it.name %></b><span><%= fmtDate(it.checkin) %> · <%= it.guests %> tamu · <%= roomName(it.room) %></span></a></li><% }) %>
    </ul><% } %>
    <a class="pill-btn" href="/admin/inquiries?status=new">Buka permintaan →</a>
  </section>
  <section class="panel action-card">
    <p class="eyebrow-a">Kedatangan terdekat</p>
    <h2><%= stats.upcoming.length ? stats.upcoming.length + ' tamu terkonfirmasi' : 'Belum ada jadwal' %></h2>
    <% if (!stats.upcoming.length) { %><p>Tamu website yang sudah dikonfirmasi akan muncul di sini.</p><% } else { %>
    <ul class="list" style="margin-bottom:16px">
      <% stats.upcoming.slice(0, 3).forEach(function (it) { %><li><a href="/admin/inquiries/<%= it.id %>"><b><%= fmtDate(it.checkin) %> · <%= it.name %></b><span><%= nights(it.checkin, it.checkout) %> malam · <%= roomName(it.room) %></span></a></li><% }) %>
    </ul><% } %>
    <a class="pill-btn" href="/admin/inquiries?status=confirmed">Lihat semua →</a>
  </section>
</div>

<section class="panel">
  <div class="panel__head"><div><p class="eyebrow-a">Ekspor data</p><h2>Unduh untuk Excel</h2></div></div>
  <p class="muted">File CSV bisa dibuka di Excel atau Google Sheets.</p>
  <div class="btns"><a class="pill-btn" href="/admin/export/customers.csv">Customer</a><a class="pill-btn" href="/admin/export/inquiries.csv">Permintaan</a>
  <% if (can('finance')) { %><a class="pill-btn" href="/admin/finance/export.csv">Keuangan</a><% } %></div>
</section>
<% } %>
<script>
(function () {
  var el = document.getElementById('clock');
  function tick() { el.textContent = new Date().toLocaleTimeString('id-ID', { timeZone: 'Asia/Jayapura', hour: '2-digit', minute: '2-digit', second: '2-digit', hour12: false }).replace(/:/g, '.'); }
  tick(); setInterval(tick, 1000);
})();
</script>
<%- include('_bottom') %>
