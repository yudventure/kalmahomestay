<%# Site header. Needs: lang, t, home, anchor(h), feedbackPath, (optional) alt = { id, en }, current %>
<% var altLinks = locals.alt || { id: '/', en: '/en' }; var cur = locals.current || ''; %>
<header class="nav" id="top">
  <div class="wrap nav__in">
    <a href="<%= home %>" class="nav__logo" aria-label="Kalma Raja Ampat"><img src="/brand/assets/kalma-wordmark.png" alt="Kalma" width="110" height="53"></a>
    <nav class="nav__links" id="menu" aria-label="Menu">
      <a href="<%= anchor('#top') %>"<%- cur === 'home' ? ' aria-current="page"' : '' %>><%- t('nav.home') %></a>
      <a href="<%= anchor('#kamar') %>"<%- cur === 'services' ? ' aria-current="page"' : '' %>><%- t('nav.rooms') %></a>
      <a href="<%= anchor('#pengalaman') %>"><%- t('nav.exp') %></a>
      <a href="<%= anchor('#lokasi') %>"><%- t('nav.loc') %></a>
      <a href="<%= anchor('#faq') %>"><%- t('nav.faq') %></a>
    </nav>
    <div class="nav__right">
      <div class="lang" role="group" aria-label="Bahasa / Language">
        <a href="<%= altLinks.id %>" hreflang="id" lang="id"<%- lang === 'id' ? ' aria-current="page"' : '' %>>ID</a>
        <a href="<%= altLinks.en %>" hreflang="en" lang="en"<%- lang === 'en' ? ' aria-current="page"' : '' %>>EN</a>
      </div>
      <a href="<%= feedbackPath %>" class="nav__hear"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M21 12a9 9 0 0 1-13.5 7.8L3 21l1.2-4.4A9 9 0 1 1 21 12z"/><path d="M8.5 10.5h7M8.5 13.5h4.5"/></svg><span><%- t('nav.feedback') %></span></a>
      <button class="nav__burger" type="button" aria-controls="menu" aria-expanded="false" aria-label="Menu"><span></span><span></span></button>
    </div>
  </div>
</header>
