<%# Site footer. Needs: t, contact, anchor(h), feedbackPath, year, (optional) lang %>
<% var isEn = (locals.lang || 'en') === 'en'; %>
<footer class="foot">
  <div class="wrap">
    <div class="foot__mid">
      <img class="foot__logo" src="/brand/assets/kalma-logo-white.png" alt="Kalma Raja Ampat" width="130" height="76">
      <nav class="foot__nav" aria-label="Footer">
        <a href="<%= anchor('#kamar') %>"><%- t('nav.rooms') %></a><a href="<%= anchor('#pengalaman') %>"><%- t('nav.exp') %></a>
        <a href="<%= anchor('#lokasi') %>"><%- t('nav.loc') %></a><a href="<%= anchor('#faq') %>">FAQ</a>
        <a href="<%= feedbackPath %>"><%- t('nav.feedback') %></a>
      </nav>
      <div class="foot__social">
        <a href="<%= contact.instagramUrl %>" target="_blank" rel="noopener" aria-label="Instagram"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1" class="fill"/></svg></a>
        <a href="https://wa.me/<%= contact.whatsapp %>" target="_blank" rel="noopener" aria-label="WhatsApp" class="foot__wa"><svg viewBox="0 0 24 24" aria-hidden="true"><path class="fill" d="M20.52 3.48A11.8 11.8 0 0 0 12.06 0C5.5 0 .16 5.34.16 11.9c0 2.1.55 4.14 1.6 5.95L.06 24l6.3-1.65a11.9 11.9 0 0 0 5.7 1.45h.01c6.56 0 11.9-5.34 11.9-11.9 0-3.18-1.24-6.17-3.45-8.42zM12.07 21.8h-.01a9.9 9.9 0 0 1-5.04-1.38l-.36-.21-3.74.98 1-3.65-.24-.37a9.86 9.86 0 0 1-1.51-5.27c0-5.45 4.44-9.89 9.9-9.89 2.64 0 5.13 1.03 7 2.9a9.83 9.83 0 0 1 2.9 7c0 5.46-4.44 9.89-9.9 9.89zm5.43-7.4c-.3-.15-1.76-.87-2.03-.97-.27-.1-.47-.15-.67.15-.2.3-.77.97-.94 1.17-.17.2-.35.22-.65.07-.3-.15-1.26-.46-2.4-1.48-.88-.79-1.48-1.76-1.66-2.06-.17-.3-.02-.46.13-.6.13-.14.3-.35.45-.52.15-.17.2-.3.3-.5.1-.2.05-.37-.03-.52-.07-.15-.67-1.62-.92-2.22-.24-.58-.49-.5-.67-.51h-.57c-.2 0-.52.07-.8.37-.27.3-1.04 1.02-1.04 2.48s1.07 2.88 1.21 3.08c.15.2 2.1 3.2 5.08 4.49.71.31 1.26.49 1.7.63.71.23 1.36.2 1.87.12.57-.08 1.76-.72 2-1.41.25-.7.25-1.29.18-1.41-.08-.13-.27-.2-.57-.35z"/></svg></a>
        <a href="mailto:<%= contact.email %>" aria-label="Email"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="3"/><path d="M4 7l8 6 8-6"/></svg></a>
      </div>
    </div>
    <div class="foot__legal">
      <nav class="foot__links" aria-label="Legal">
        <a href="<%= isEn ? '/en/privacy' : '/privasi' %>"><%- t('foot.privacy') %></a>
        <a href="<%= isEn ? '/en/terms' : '/ketentuan' %>"><%- t('foot.terms') %></a>
      </nav>
      <a class="foot__operator" href="/admin/login" rel="nofollow"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="4.5" y="10.5" width="15" height="10" rx="2.5"/><path d="M8 10.5V7.5a4 4 0 0 1 8 0v3"/></svg><%- t('foot.operator') %></a>
    </div>
    <div class="foot__bottom">
      <span>© <%= year %> Kalma Raja Ampat · <%- t('foot.reef') %></span>
      <span class="credit"><span><%- t('foot.credit') %></span> <b>Team Dampier</b></span>
    </div>
  </div>
</footer>
