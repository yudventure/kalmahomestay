<!doctype html>
<html lang="<%= lang %>">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title><%= t('fb.meta') %></title>
<meta name="description" content="<%= t('fb.lead') %>">
<meta name="robots" content="noindex, follow">
<meta name="theme-color" content="#224866">
<link rel="icon" href="/brand/assets/favicon.ico" sizes="any">
<link rel="icon" href="/brand/assets/favicon-32.png" type="image/png" sizes="32x32">
<link rel="stylesheet" href="/brand/tokens.css?v=<%= v %>">
<link rel="stylesheet" href="/css/style.css?v=<%= v %>">
<link rel="stylesheet" href="/css/survey.css?v=<%= v %>">
<link rel="stylesheet" href="/css/feedback.css?v=<%= v %>">
</head>
<body class="sv fb">
<main class="wrap fb__main">
  <a class="fb__home" href="<%= home %>"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 5l-7 7 7 7"/></svg><%= t('fb.back') %></a>
<% if (thanks) { %>
  <section class="fb__thanks">
    <span class="fb__check" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M5 12.5l4.5 4.5L19 7.5"/></svg></span>
    <h1><%= t('fb.thanks') %></h1>
    <p class="lead"><%= t('fb.thanksText') %></p>
    <div class="fb__actions"><a class="btn btn--primary" href="<%= home %>"><%= t('fb.back') %></a></div>
  </section>
<% } else { %>
  <div class="fb__grid">
    <aside class="fb__intro">
      <div class="fb__brand">
        <a href="<%= home %>" class="fb__logo" aria-label="Kalma Raja Ampat"><img src="/brand/assets/kalma-logo-white.png" alt="Kalma" width="120" height="70"></a>
        <div class="lang lang--dark" role="group" aria-label="Bahasa / Language">
          <a href="/masukan" hreflang="id" lang="id"<%- lang === 'id' ? ' aria-current="page"' : '' %>>ID</a>
          <a href="/en/feedback" hreflang="en" lang="en"<%- lang === 'en' ? ' aria-current="page"' : '' %>>EN</a>
        </div>
      </div>
      <p class="eyebrow"><%= t('fb.eyebrow') %></p>
      <h1><%= t('fb.title') %></h1>
      <p class="fb__lead"><%= t('fb.lead') %></p>
      <ul class="fb__promise">
        <li><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="8.5"/><path d="M12 7.5V12l3 2"/></svg><%= t('fb.promise1') %></li>
        <li><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3l8 3v6c0 5-3.5 8-8 9-4.5-1-8-4-8-9V6z"/><path d="M8.5 12l2.5 2.5 4.5-5"/></svg><%= t('fb.promise2') %></li>
        <li><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="5" y="10.5" width="14" height="10" rx="2.5"/><path d="M8 10.5V8a4 4 0 0 1 8 0v2.5"/></svg><%= t('fb.promise3') %></li>
      </ul>
    </aside>

    <form class="fb__form" method="post" action="<%= action %>" novalidate>
      <% if (error) { %><p class="sv__err" role="alert"><%= error %></p><% } %>
      <div class="hp" aria-hidden="true"><label for="fb-website">Website</label><input id="fb-website" name="website" tabindex="-1" autocomplete="off"></div>

      <fieldset class="fb__kinds">
        <legend><%= t('fb.kind') %></legend>
        <% var ICON = {
             saran: '<path d="M9 18h6M10 21h4M12 3a6 6 0 0 0-3.5 10.9c.6.4 1 1.1 1 1.8V16h5v-.3c0-.7.4-1.4 1-1.8A6 6 0 0 0 12 3z"/>',
             keluhan: '<path d="M12 3.5 2.8 19.5h18.4z"/><path d="M12 10v4.5M12 17.2v.3"/>',
             pujian: '<path d="M12 20s-7.5-4.5-7.5-10.2A4.3 4.3 0 0 1 12 7.2a4.3 4.3 0 0 1 7.5 2.6C19.5 15.5 12 20 12 20z"/>',
             pertanyaan: '<circle cx="12" cy="12" r="8.5"/><path d="M9.6 9.5a2.5 2.5 0 1 1 3.4 2.3c-.6.3-1 .8-1 1.5v.5M12 16.8v.3"/>' }; %>
        <% KINDS.forEach(function (k) { %>
        <label class="fb__kind"><input type="radio" name="kind" value="<%= k %>"<%= values.kind === k ? ' checked' : '' %> required><span><svg viewBox="0 0 24 24" aria-hidden="true"><%- ICON[k] %></svg><%= t('fb.k.' + k) %></span></label>
        <% }) %>
      </fieldset>

      <div class="fb__row">
        <div class="fb__field"><label for="fb-topic"><%= t('fb.topic') %></label>
          <select id="fb-topic" name="topic"><% TOPICS.forEach(function (tp) { %><option value="<%= tp %>"<%= values.topic === tp ? ' selected' : '' %>><%= t('fb.t.' + tp) %></option><% }) %></select></div>
        <fieldset class="fb__field fb__stars"><legend><%= t('fb.rating') %></legend>
          <div class="fb__stars-in"><% [5, 4, 3, 2, 1].forEach(function (n) { %><input type="radio" id="fb-r<%= n %>" name="rating" value="<%= n %>"<%= String(values.rating) === String(n) ? ' checked' : '' %>><label for="fb-r<%= n %>" title="<%= n %>/5"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3.5l2.6 5.4 5.9.8-4.3 4.1 1 5.8-5.2-2.8-5.2 2.8 1-5.8-4.3-4.1 5.9-.8z"/></svg><span class="sr"><%= n %>/5</span></label><% }) %></div>
        </fieldset>
      </div>

      <div class="fb__field"><label for="fb-msg"><%= t('fb.message') %></label>
        <textarea id="fb-msg" name="message" rows="6" maxlength="4000" required minlength="10" placeholder="<%= t('fb.messagePh') %>"><%= values.message %></textarea></div>

      <div class="fb__row">
        <div class="fb__field"><label for="fb-email"><%= t('fb.email') %></label><input id="fb-email" name="email" type="email" maxlength="120" autocomplete="email" required value="<%= values.email %>"><small><%= t('fb.contactHint') %></small></div>
        <div class="fb__field"><label for="fb-phone"><%= t('fb.phone') %></label><input id="fb-phone" name="phone" type="tel" maxlength="20" autocomplete="tel" required placeholder="+62 812 3456 7890" value="<%= values.phone %>"></div>
      </div>
      <div class="fb__row">
        <div class="fb__field"><label for="fb-name"><%= t('fb.name') %></label><input id="fb-name" name="name" maxlength="120" autocomplete="name" value="<%= values.name %>"></div>
        <div class="fb__field"><label for="fb-stay"><%= t('fb.stay') %></label><input id="fb-stay" name="stay_date" type="date" value="<%= values.stay_date %>"></div>
      </div>

      <div class="fb__submit">
        <button class="btn btn--primary" type="submit"><%= t('fb.send') %><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 12h14M13 6l6 6-6 6"/></svg></button>
        <small><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="5" y="10.5" width="14" height="10" rx="2.5"/><path d="M8 10.5V8a4 4 0 0 1 8 0v2.5"/></svg><%= t('fb.privacy') %></small>
      </div>
    </form>
  </div>
<% } %>
</main>
</body>
</html>
