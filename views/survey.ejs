<!doctype html>
<html lang="<%= lang %>">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title><%= t('survey.meta') %></title>
<meta name="description" content="<%= t('survey.title') %>">
<meta name="robots" content="noindex, follow">
<meta name="theme-color" content="#EDE0B5">
<meta property="og:title" content="<%= t('survey.meta') %>">
<meta property="og:description" content="<%= t('survey.title') %>">
<meta property="og:image" content="<%= siteUrl %>/brand/assets/kalma-logo-original.png">
<link rel="icon" href="/brand/assets/favicon.ico" sizes="any">
<link rel="icon" href="/brand/assets/favicon-32.png" type="image/png" sizes="32x32">
<link rel="stylesheet" href="/brand/tokens.css?v=<%= v %>">
<link rel="stylesheet" href="/css/style.css?v=<%= v %>">
<link rel="stylesheet" href="/css/survey.css?v=<%= v %>">
</head>
<body class="sv">
<header class="sv__head">
  <div class="wrap sv__bar">
    <a href="<%= home %>"><img src="/brand/assets/kalma-wordmark.png" alt="Kalma" width="100" height="48"></a>
    <div class="lang" role="group" aria-label="Bahasa / Language">
      <a href="/survey" hreflang="id" lang="id"<%- lang === 'id' ? ' aria-current="page"' : '' %>>ID</a>
      <a href="/en/survey" hreflang="en" lang="en"<%- lang === 'en' ? ' aria-current="page"' : '' %>>EN</a>
    </div>
  </div>
</header>

<main class="wrap sv__main">
<% if (thanks) { %>
  <section class="sv__thanks">
    <img src="/brand/assets/kalma-icon-sand.png" alt="" width="96" height="96">
    <h1><%= t('survey.thanks') %></h1>
    <p class="lead"><%= t('survey.thanksText') %></p>
    <a class="btn btn--primary" href="<%= home %>"><%= t('survey.back') %></a>
  </section>
<% } else { %>
  <div class="sv__intro">
    <p class="eyebrow"><%= t('survey.eyebrow') %></p>
    <h1><%= t('survey.title') %></h1>
    <p class="lead"><%= t('survey.intro') %></p>
    <p class="sv__req"><%= t('survey.required') %></p>
  </div>

  <form class="sv__form" method="post" action="<%= base %>/survey" novalidate>
    <% if (error) { %><p class="sv__err" role="alert"><%= error %></p><% } %>
    <div class="hp" aria-hidden="true"><label for="sv-website">Website</label><input id="sv-website" name="website" tabindex="-1" autocomplete="off"></div>

    <% var n = 0; sections.forEach(function (sec) { %>
    <fieldset class="sv__sec">
      <legend><span><%= sec.id %></span> <%= sec.title[lang] %></legend>
      <% sec.questions.forEach(function (q) { n += 1;
           var val = q.contact ? contact : answers[q.id];
           var bad = missing.indexOf(q.id) !== -1; %>
      <div class="sv__q<%= bad ? ' is-invalid' : '' %>" id="<%= q.id %>">
        <% if (q.type === 'single' || q.type === 'multi') { %>
        <fieldset class="sv__group"<%- q.max ? ' data-max="' + q.max + '"' : '' %>>
          <legend class="sv__label"><span class="sv__n"><%= n %>.</span> <%= q.text[lang] %><%= q.required ? ' *' : '' %>
            <% if (q.type === 'multi') { %><small><%= q.max ? t('survey.max').replace('{n}', q.max) : t('survey.any') %></small><% } %></legend>
          <div class="sv__opts">
          <% q.options.forEach(function (op) {
               var checked = q.type === 'multi' ? (Array.isArray(val) && val.indexOf(op.id) !== -1) : val === op.id; %>
            <label class="sv__opt"><input type="<%= q.type === 'multi' ? 'checkbox' : 'radio' %>" name="<%= q.id %>" value="<%= op.id %>"<%= checked ? ' checked' : '' %><%= q.required && q.type === 'single' ? ' required' : '' %>><span><%= op.label[lang] %></span></label>
          <% }) %>
          </div>
        </fieldset>
        <% } else { %>
        <label class="sv__label" for="f-<%= q.id %>"><span class="sv__n"><%= n %>.</span> <%= q.text[lang] %><%= q.required ? ' *' : '' %></label>
          <% if (q.type === 'text') { %>
          <textarea id="f-<%= q.id %>" name="<%= q.id %>" rows="3" maxlength="2000"<%= q.required ? ' required' : '' %>><%= val || '' %></textarea>
          <% } else { %>
          <input id="f-<%= q.id %>" name="<%= q.id %>" maxlength="120" value="<%= val || '' %>" placeholder="<%= q.placeholder ? q.placeholder[lang] : '' %>"<%= q.contact ? ' autocomplete="email"' : '' %>>
          <% } %>
        <% } %>
      </div>
      <% }) %>
    </fieldset>
    <% }) %>

    <p class="sv__privacy"><%= t('survey.privacy') %></p>
    <button class="btn btn--cta btn--block" type="submit"><%= t('survey.submit') %></button>
  </form>
<% } %>
</main>

<footer class="wrap sv__foot">© Kalma Raja Ampat · <span><%= t('foot.credit') %></span> <b>Team Dampier</b></footer>
<script src="/js/survey.js" defer></script>
</body>
</html>
